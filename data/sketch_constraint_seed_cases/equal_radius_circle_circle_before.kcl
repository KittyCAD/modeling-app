@settings(experimentalFeatures = allow)

s = sketch(on = XY) {
  a = circle(start = [var 5mm, var 0mm], center = [var 0mm, var 0mm])
  b = circle(start = [var 14.9mm, var 0mm], center = [var 10mm, var 0mm])

  fixed([a.center, [0mm, 0mm]])
  fixed([a.start, [5mm, 0mm]])
  fixed([b.center, [10mm, 0mm]])
  b.start.at[1] == 0mm
}
