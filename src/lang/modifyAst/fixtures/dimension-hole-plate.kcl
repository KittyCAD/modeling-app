@settings(kclVersion = 2.0)

sketch001 = sketch(on = XY) {
  point1 = point(at = [var 0mm, var 0mm])
  line1 = line(start = [var -4mm, var -2mm], end = [var 4mm, var -2mm], construction = true)
  line2 = line(start = [var 4mm, var -2mm], end = [var 4mm, var 2mm], construction = true)
  line3 = line(start = [var 4mm, var 2mm], end = [var -4mm, var 2mm], construction = true)
  line4 = line(start = [var -4mm, var 2mm], end = [var -4mm, var -2mm], construction = true)
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
  parallel([line2, line4])
  parallel([line3, line1])
  perpendicular([line1, line2])
  horizontal(line3)
  line5 = line(start = [var -4mm, var -2mm], end = [var 4mm, var 2mm], construction = true)
  line6 = line(start = [var 4mm, var -2mm], end = [var -4mm, var 2mm], construction = true)
  coincident([line5.start, line1.start])
  coincident([line5.end, line2.end])
  coincident([line6.start, line1.end])
  coincident([line6.end, line4.start])
  coincident([point1, line5])
  coincident([point1, line6])
  equalLength([line5, line6])
  coincident([point1, ORIGIN])
  point2 = point(at = [var 0mm, var 0mm])
  line7 = line(start = [var -6mm, var -3mm], end = [var 6mm, var -3mm])
  line8 = line(start = [var 6mm, var -3mm], end = [var 6mm, var 3mm])
  line9 = line(start = [var 6mm, var 3mm], end = [var -6mm, var 3mm])
  line10 = line(start = [var -6mm, var 3mm], end = [var -6mm, var -3mm])
  coincident([line7.end, line8.start])
  coincident([line8.end, line9.start])
  coincident([line9.end, line10.start])
  coincident([line10.end, line7.start])
  parallel([line8, line10])
  parallel([line9, line7])
  perpendicular([line7, line8])
  horizontal(line9)
  line11 = line(start = [var -6mm, var -3mm], end = [var 6mm, var 3mm], construction = true)
  line12 = line(start = [var 6mm, var -3mm], end = [var -6mm, var 3mm], construction = true)
  coincident([line11.start, line7.start])
  coincident([line11.end, line8.end])
  coincident([line12.start, line7.end])
  coincident([line12.end, line10.start])
  coincident([point2, line11])
  coincident([point2, line12])
  equalLength([line11, line12])
  coincident([point2, point1])
  circle1 = circle(start = [var -3.67mm, var 1.63mm], center = [var -4mm, var 2mm])
  coincident([circle1.center, line6.end])
  circle2 = circle(start = [var -3.54mm, var -2.19mm], center = [var -4mm, var -2mm])
  coincident([circle2.center, line5.start])
  circle3 = circle(start = [var 4.5mm, var -1.97mm], center = [var 4mm, var -2mm])
  coincident([circle3.center, line6.start])
  circle4 = circle(start = [var 4.4mm, var 1.7mm], center = [var 4mm, var 2mm])
  coincident([circle4.center, line5.end])
  equalRadius([circle4, circle3, circle2, circle1])
  diameter(circle4) == 1
  distance([line9.start, line9.end]) == 12
  distance([line10.start, line10.end]) == 6
  distance([line3.start, line3.end]) == 8
  distance([line4.start, line4.end]) == 4
}
hidden001 = hide(sketch001)
region001 = region(segments = [sketch001.line10, sketch001.line7])
extrude001 = extrude(region001, length = 1, tagEnd = $capEnd001)
