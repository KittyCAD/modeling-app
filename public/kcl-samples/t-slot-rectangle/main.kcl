// T-Slotted Rectangle Frame
// A rectangular frame made up of T-slotted rails
// Categories: Manufacturing, Construction

// Set units
@settings(defaultLengthUnit = in, kclVersion = 2.0)

frameLength = 2ft
frameWidth = 1.5ft
railHeight = 1

fn railTslot(railHeight, length) {
  holeDiameter = 0.262
  // Solve the complete rail outline directly. The explicit points preserve the
  // mirrored legacy profile without relying on the deprecated Sketch V1 API.
  railLeg = sketch(on = -XZ) {
    line1 = line(start = [var 0.5in, var 0.322in], end = [var 0.42in, var 0.322in])
    arc2 = arc(
      start = [var 0.42in, var 0.322in],
      end = [
        var 0.3563603896932107in,
        var 0.2956396103067893in
      ],
      center = [var 0.42in, var 0.232in],
    )
    coincident([line1.end, arc2.start])
    line3 = line(
      start = [
        var 0.3563603896932107in,
        var 0.2956396103067893in
      ],
      end = [var 0.17372077938642136in, var 0.113in],
    )
    coincident([arc2.end, line3.start])
    arc4 = arc(
      start = [var 0.17372077938642136in, var 0.113in],
      end = [
        var 0.18079184719828684in,
        var 0.09592893218813453in
      ],
      center = [
        var 0.18079184719828684in,
        var 0.10592893218813453in
      ],
    )
    coincident([line3.end, arc4.start])
    line5 = line(
      start = [
        var 0.18079184719828684in,
        var 0.09592893218813453in
      ],
      end = [var 0.33in, var 0.09592893218813453in],
    )
    coincident([arc4.end, line5.start])
    arc6 = arc(start = [var 0.34in, var 0.08592893218813454in], end = [var 0.33in, var 0.09592893218813453in], center = [var 0.33in, var 0.08592893218813454in])
    coincident([line5.end, arc6.end])
    line7 = line(start = [var 0.34in, var 0.08592893218813454in], end = [var 0.34in, var 0.01in])
    coincident([arc6.start, line7.start])
    arc8 = arc(start = [var 0.33in, var 0in], end = [var 0.34in, var 0.01in], center = [var 0.33in, var 0.01in])
    coincident([line7.end, arc8.end])
    line9 = line(start = [var 0.33in, var 0in], end = [var 0.3in, var 0in])
    coincident([arc8.start, line9.start])
    arc10 = arc(start = [var 0.3in, var 0in], end = [var 0.264in, var 0in], center = [var 0.282in, var 0in])
    coincident([line9.end, arc10.start])
    line11 = line(start = [var 0.264in, var 0in], end = [var 0.164in, var 0in])
    coincident([arc10.end, line11.start])
    arc12 = arc(start = [var 0.164in, var 0in], end = [var 0.128in, var 0in], center = [var 0.146in, var 0in])
    coincident([line11.end, arc12.start])
    line13 = line(start = [var 0.128in, var 0in], end = [var 0.098in, var 0in])
    coincident([arc12.end, line13.start])
    arc14 = arc(start = [var 0.0275in, var 0.0275in], end = [var 0.098in, var 0in], center = [var 0.098in, var 0.10411818181818162in])
    coincident([line13.end, arc14.end])
  }
  railSketch = railLeg
    |> mirror2d(axis = {
         direction = [1.0, 1.0],
         origin = [0.0, 0.0]
       })
    |> mirror2d(axis = {
         direction = [1.0, 0.0],
         origin = [0.0, 0.5]
       })
    |> mirror2d(axis = {
         direction = [0.0, 1.0],
         origin = [0.5, 0.0]
       })
  railRegion = region(segments = [railLeg.line1, railLeg.arc2])
    |> scale(x = railHeight, y = railHeight, z = railHeight)
  railBlank = extrude(railRegion, length)

  // Cut the center bore in 3D instead of using deprecated subtract2d.
  boreSketch = sketch(on = -XZ) {
    boreCircle = circle(start = [var 0.88in, var 0.75in], center = [var 0.75in, var 0.75in])
    horizontalDistance([ORIGIN, boreCircle.center]) == railHeight / 2
    verticalDistance([ORIGIN, boreCircle.center]) == railHeight / 2
    radius(boreCircle) == holeDiameter / 2
  }
  boreRegion = region(segments = [boreSketch.boreCircle])
  bore = extrude(boreRegion, length)
  railProfile = subtract(railBlank, tools = [bore])
  hide([railLeg, railSketch, boreSketch])

  return railProfile
}

// Generate a pair of rails along the X direction
railTslot(railHeight, length = frameWidth)
  |> rotate(yaw = 90)
  |> patternLinear3d(instances = 2, distance = frameLength - railHeight, axis = [0, 1, 0])

// Generate a pair of rails along the Y direction
railTslot(railHeight, length = frameLength - (2 * railHeight))
  |> patternLinear3d(instances = 2, distance = frameWidth - railHeight, axis = [-1, 0, 0])
