// Camshaft
// A camshaft is a rotating shaft with cam lobes that open and close an engine’s intake and exhaust valves at precise times. The lobe shape and timing control valve lift and duration, directly affecting engine performance and efficiency.
// Categories: Automotive

@settings(defaultLengthUnit = in, kclVersion = 2.0, experimentalFeatures = allow)

valvesPerCylinder = 4
cylinderCount = 4
shaftDiameter = 0.97
supportBearingWidth = 0.45

baseCircle = 1.34
lobeSeparation = 112
intakeCenterline = 108
intakeLift = 0.235
exhaustLift = 0.235
intakeDuration = 242
exhaustDuration = 246
camHeight = 0.522
camSpacing = 0.50

// Inline each lobe so its distinct valve duration remains visible in the model.
// The four tangent arcs are the exact KCL 2 equivalent of the legacy profile.
intakeSketch = sketch(on = offsetPlane(XY, offset = supportBearingWidth * 2)) {
  baseArc = arc(
    start = [
      var -0.583138316280in,
      var 0.329923785269in
    ],
    end = [
      var 0.583138316280in,
      var 0.329923785269in
    ],
    center = [var 0in, var 0in],
  )
  rightFlank = arc(
    start = [
      var 0.583138316280in,
      var 0.329923785269in
    ],
    end = [
      var 0.134503674324in,
      var 0.862591154386in
    ],
    center = [
      var -1.063568154576in,
      var -0.601737909607in
    ],
  )
  coincident([baseArc.end, rightFlank.start])
  noseArc = arc(
    start = [
      var 0.134503674324in,
      var 0.862591154386in
    ],
    end = [
      var -0.134503674324in,
      var 0.862591154386in
    ],
    center = [var 0in, var 0.698195640000in],
  )
  coincident([rightFlank.end, noseArc.start])
  leftFlank = arc(
    start = [
      var -0.134503674324in,
      var 0.862591154386in
    ],
    end = [
      var -0.583138316280in,
      var 0.329923785269in
    ],
    center = [
      var 1.063568154576in,
      var -0.601737909607in
    ],
  )
  coincident([noseArc.end, leftFlank.start])
  coincident([leftFlank.end, baseArc.start])
  tangent([baseArc, rightFlank])
  tangent([rightFlank, noseArc])
  tangent([noseArc, leftFlank])
  tangent([leftFlank, baseArc])
}
intake = extrude(
  region(segments = [
    intakeSketch.baseArc,
    intakeSketch.rightFlank
  ]),
  length = camHeight,
)
  |> rotate(yaw = intakeCenterline)

exhaustSketch = sketch(on = offsetPlane(XY, offset = supportBearingWidth * 2)) {
  baseArc = arc(
    start = [
      var -0.588807465484in,
      var 0.319696369374in
    ],
    end = [
      var 0.588807465484in,
      var 0.319696369374in
    ],
    center = [var 0in, var 0in],
  )
  rightFlank = arc(
    start = [
      var 0.588807465484in,
      var 0.319696369374in
    ],
    end = [
      var 0.134503674324in,
      var 0.862591154386in
    ],
    center = [
      var -0.981768348187in,
      var -0.533056720373in
    ],
  )
  coincident([baseArc.end, rightFlank.start])
  noseArc = arc(
    start = [
      var 0.134503674324in,
      var 0.862591154386in
    ],
    end = [
      var -0.134503674324in,
      var 0.862591154386in
    ],
    center = [var 0in, var 0.694424470000in],
  )
  coincident([rightFlank.end, noseArc.start])
  leftFlank = arc(
    start = [
      var -0.134503674324in,
      var 0.862591154386in
    ],
    end = [
      var -0.588807465484in,
      var 0.319696369374in
    ],
    center = [
      var 0.981768348187in,
      var -0.533056720373in
    ],
  )
  coincident([noseArc.end, leftFlank.start])
  coincident([leftFlank.end, baseArc.start])
  tangent([baseArc, rightFlank])
  tangent([rightFlank, noseArc])
  tangent([noseArc, leftFlank])
  tangent([leftFlank, baseArc])
}
exhaust = extrude(
  region(segments = [
    exhaustSketch.baseArc,
    exhaustSketch.rightFlank
  ]),
  length = camHeight,
)
  |> rotate(yaw = intakeCenterline)
  |> translate(z = camHeight + camSpacing)
  |> rotate(yaw = lobeSeparation)

fn valveCount(@i) {
  return {
    translate = [0, 0, i * (camHeight + camSpacing) * 2],
    rotation = {
      angle = lobeSeparation + 30 * i,
      origin = 'global'
    }
  }
}

fn cylinderPattern(@i) {
  return {
    translate = [
      0,
      0,
      i * (2 * (camHeight + camSpacing) * round(valvesPerCylinder / 2) + supportBearingWidth)
    ],
    rotation = {
      angle = 360deg / cylinderCount * i,
      origin = 'global'
    }
  }
}

[intake, exhaust]
  |> patternTransform(instances = round(valvesPerCylinder / 2), transform = valveCount)
  |> patternTransform(instances = cylinderCount, transform = cylinderPattern)

length = (2 * (camHeight + camSpacing) * round(valvesPerCylinder / 2) + supportBearingWidth) * cylinderCount + supportBearingWidth
shaftSketch = sketch(on = XY) {
  shaft = circle(start = [var 0.485in, var 0in], center = [var 0in, var 0in])
}
centerShaft = extrude(region(segments = [shaftSketch.shaft]), length)

timingGearBlank = gear::helical(
  nTeeth = 15,
  module = .15,
  pressureAngle = 20deg,
  helixAngle = 55deg,
  gearHeight = supportBearingWidth,
)
timingGearBoreSketch = sketch(on = XY) {
  bore = circle(start = [var 0.485in, var 0in], center = [var 0in, var 0in])
}
timingGearBore = extrude(region(segments = [timingGearBoreSketch.bore]), length = supportBearingWidth)
timingGear = subtract(timingGearBlank, tools = [timingGearBore])

hide(intakeSketch)
hide(exhaustSketch)
hide(shaftSketch)
hide(timingGearBoreSketch)
