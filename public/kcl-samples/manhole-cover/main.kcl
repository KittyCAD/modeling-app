// Vented Manhole Cover
// A cast-iron cover with traffic-safe ventilation slots and a side pick hole.
// Categories: Construction

@settings(defaultLengthUnit = in, kclVersion = 2.0)

coverDiameter = 22 + 3 / 4
edgeThickness = 1 + 3 / 4
pickHoleLength = 1
pickHoleWidth = 2
pickHoleDepth = 1 + 1 / 8

// The cover outline and all nine ventilation loops live in one sketch. The
// outer region therefore already contains the voids that legacy CSG created.
