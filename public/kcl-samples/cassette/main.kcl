// Sprocket Cassette
// A seven-speed stack of sprockets mounted on a common hub.
// Categories: Automotive

@settings(defaultLengthUnit = in, kclVersion = 2.0, experimentalFeatures = allow)

chainPitch = 1 / 4
rollerWidth = 3 / 32
shaftDiameter = 12mm

fn sprocket(@speed, nTeeth) {
  pitchDiameter = chainPitch / sin(180deg / nTeeth)
  module = pitchDiameter / nTeeth
  thickness = rollerWidth / 2
  zOffset = -speed * rollerWidth

  body = gear::spur(
    nTeeth,
    module,
    pressureAngle = 20deg,
    gearHeight = thickness,
  )
    |> translate(z = zOffset)

  boreSketch = sketch(on = offsetPlane(XY, offset = zOffset)) {
    bore = circle(start = [var 6mm, var 0in], center = [var 0in, var 0in])
  }
  bore = extrude(region(segments = [boreSketch.bore]), length = thickness)
  toothedBody = subtract(body, tools = [bore])

  spacerOuterSketch = sketch(on = offsetPlane(XY, offset = zOffset + thickness)) {
    outer = circle(start = [var 7.8mm, var 0in], center = [var 0in, var 0in])
  }
  spacerOuter = extrude(region(segments = [spacerOuterSketch.outer]), length = thickness)
  spacerBoreSketch = sketch(on = offsetPlane(XY, offset = zOffset + thickness)) {
    inner = circle(start = [var 6mm, var 0in], center = [var 0in, var 0in])
  }
  spacerBore = extrude(region(segments = [spacerBoreSketch.inner]), length = thickness)
  spacer = subtract(spacerOuter, tools = [spacerBore])
    |> appearance(color = "#0f0f0f")

  hide(boreSketch)
  hide(spacerOuterSketch)
  hide(spacerBoreSketch)
  return toothedBody
}

reduce(
  [11, 15, 19, 23, 27, 31, 36],
  initial = 0_,
  f = fn(@nTeeth, accum) {
    sprocket(accum + 1, nTeeth)
    return accum + 1
  },
)
