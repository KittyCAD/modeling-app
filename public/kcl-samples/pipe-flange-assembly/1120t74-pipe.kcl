// Pipe (1120T74)

@settings(defaultLengthUnit = in, kclVersion = 2.0, experimentalFeatures = allow)

import pipeLength from "parameters.kcl"

export fn pipe() {
  outerSketch = sketch(on = XY) {
    outer = circle(start = [var 1.1875in, var 0in], center = [var 0in, var 0in])
  }
  outer = extrude(region(segments = [outerSketch.outer]), length = pipeLength)
  innerSketch = sketch(on = XY) {
    inner = circle(start = [var 1in, var 0in], center = [var 0in, var 0in])
  }
  inner = extrude(region(segments = [innerSketch.inner]), length = pipeLength)
  result = subtract(outer, tools = [inner])
    |> appearance(color = "#5b3f8c")
  return result
}
