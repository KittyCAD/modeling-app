// Gasket (9472K188)

@settings(defaultLengthUnit = in, kclVersion = 2.0, experimentalFeatures = allow)

import gasketThickness from "parameters.kcl"

outerSketch = sketch(on = XY) {
  outer = circle(start = [var 2.0625in, var 0in], center = [var 0in, var 0in])
}
outer = extrude(region(segments = [outerSketch.outer]), length = gasketThickness)
innerSketch = sketch(on = XY) {
  inner = circle(start = [var 1.1875in, var 0in], center = [var 0in, var 0in])
}
inner = extrude(region(segments = [innerSketch.inner]), length = gasketThickness)
subtract(outer, tools = [inner])
  |> appearance(color = "#d6b72c")
