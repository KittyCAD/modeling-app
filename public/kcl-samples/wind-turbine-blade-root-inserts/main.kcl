// Wind Turbine Blade
// A 52 m tapered wind-turbine blade with a hollow root sleeve and sixteen metallic root inserts.
// Categories: Construction

@settings(defaultLengthUnit = m, kclVersion = 2.0, experimentalFeatures = allow)

rootOuterSketch = sketch(on = YZ) {
  outer = circle(start = [var 0.75m, var 0m], center = [var 0m, var 0m])
}
rootOuter = extrude(region(segments = [rootOuterSketch.outer]), length = 1)
rootInnerSketch = sketch(on = YZ) {
  inner = circle(start = [var 0.55m, var 0m], center = [var 0m, var 0m])
}
rootInner = extrude(region(segments = [rootInnerSketch.inner]), length = 1)
rootSleeve = subtract(rootOuter, tools = [rootInner])

insertSketch = sketch(on = YZ) {
  insert = circle(start = [var 0.05m, var 0.65m], center = [var 0m, var 0.65m])
}
insert = extrude(region(segments = [insertSketch.insert]), length = 0.75)
  |> patternCircular3d(
       instances = 16,
       axis = X,
       center = [0, 0, 0],
       arcDegrees = 360deg,
       rotateDuplicates = false,
     )
  |> appearance(color = "#b87333", metalness = 70, roughness = 30)

rootSectionSketch = sketch(on = offsetPlane(YZ, offset = 1)) {
  line1 = line(start = [var -0.62m, var -0.42m], end = [var 0.62m, var -0.42m])
  line2 = line(start = [var 0.62m, var -0.42m], end = [var 0m, var 0.75m])
  coincident([line1.end, line2.start])
  line3 = line(start = [var 0m, var 0.75m], end = [var -0.62m, var -0.42m])
  coincident([line2.end, line3.start])
  coincident([line3.end, line1.start])
}
rootSection = region(segments = [
  rootSectionSketch.line1,
  rootSectionSketch.line2
])

midSectionSketch = sketch(on = offsetPlane(YZ, offset = 17.33)) {
  line1 = line(start = [var -0.75m, var -0.55m], end = [var 0.75m, var -0.35m])
  line2 = line(start = [var 0.75m, var -0.35m], end = [var 0.2m, var 2.1m])
  coincident([line1.end, line2.start])
  line3 = line(start = [var 0.2m, var 2.1m], end = [var -0.75m, var -0.55m])
  coincident([line2.end, line3.start])
  coincident([line3.end, line1.start])
}
midSection = region(segments = [
  midSectionSketch.line1,
  midSectionSketch.line2
])

outerSectionSketch = sketch(on = offsetPlane(YZ, offset = 51)) {
  line1 = line(start = [var -0.22m, var -0.16m], end = [var 0.22m, var -0.1m])
  line2 = line(start = [var 0.22m, var -0.1m], end = [var 0.06m, var 0.8m])
  coincident([line1.end, line2.start])
  line3 = line(start = [var 0.06m, var 0.8m], end = [var -0.22m, var -0.16m])
  coincident([line2.end, line3.start])
  coincident([line3.end, line1.start])
}
outerSection = region(segments = [
  outerSectionSketch.line1,
  outerSectionSketch.line2
])

tipSectionSketch = sketch(on = offsetPlane(YZ, offset = 52)) {
  line1 = line(start = [var -0.04m, var -0.03m], end = [var 0.04m, var -0.02m])
  line2 = line(start = [var 0.04m, var -0.02m], end = [var 0m, var 0.14m])
  coincident([line1.end, line2.start])
  line3 = line(start = [var 0m, var 0.14m], end = [var -0.04m, var -0.03m])
  coincident([line2.end, line3.start])
  coincident([line3.end, line1.start])
}
tipSection = region(segments = [
  tipSectionSketch.line1,
  tipSectionSketch.line2
])

blade = loft([
  rootSection,
  midSection,
  outerSection,
  tipSection
])
  |> appearance(color = "#ffffff", roughness = 70)

hide(rootOuterSketch)
hide(rootInnerSketch)
hide(insertSketch)
hide(rootSectionSketch)
hide(midSectionSketch)
hide(outerSectionSketch)
hide(tipSectionSketch)
