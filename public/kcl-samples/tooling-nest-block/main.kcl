// Tooling Nest Block
// A tooling nest block is a block-shaped tool made from high-carbon steel. It features an assortment of conical or hemispherical indentions, which are used to form or shape metal, particularly in crafting bells or jewelry
// Categories: Manufacturing, Construction

// Set units
@settings(defaultLengthUnit = mm)

// Define parameters
sideLength = 50
size01 = 15
size02 = 10
size03 = 6
size04 = 0.375in
size05 = 0.25in
size06 = 0.5in
size07 = 0.75in
size08 = 5
size09 = 4.5
size10 = 4
size11 = 3.5
size12 = 3
size13 = 2.5
size14 = 2
size15 = 1

// Sketch and extrude the base cube
cubeSketch = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  |> angledLine(angle = 0, length = sideLength, tag = $rectangleSegmentA001)
  |> angledLine(angle = segAng(rectangleSegmentA001) + 90, length = sideLength, tag = $rectangleSegmentB001)
  |> angledLine(angle = segAng(rectangleSegmentA001), length = -segLen(rectangleSegmentA001), tag = $rectangleSegmentC001)
  |> line(endAbsolute = [profileStartX(%), profileStartY(%)], tag = $rectangleSegmentD001)
  |> close()
cubeExtrude = extrude(cubeSketch, length = sideLength)

// Write a function to create a hemispherical nest in a given cube side
fn nest(cubeFace, xPos, yPos, nestSize) {
  // Round a separate cutter before subtracting it so its edge references
  // remain valid throughout the fillet operation.
  nestPlane = offsetPlane(planeOf(cubeExtrude, face = cubeFace), offset = 0)
  nestFn = startSketchOn(nestPlane)
    |> circle(center = [xPos * sideLength, yPos * sideLength], radius = nestSize, tag = $seg01)
    |> extrude(length = -nestSize)
    |> fillet(
         radius = nestSize * .99,
         tags = [
           getOppositeEdge(seg01)
         ],
       )
  return nestFn
}

// Model each nest on the top face
nest001 = nest(
  cubeFace = END,
  xPos = 0.5,
  yPos = 0.5,
  nestSize = size01,
)

// Model each nest on side 1
nest002 = nest(
  cubeFace = rectangleSegmentA001,
  xPos = 0.65,
  yPos = 0.5,
  nestSize = size02,
)
nest003 = nest(
  cubeFace = rectangleSegmentA001,
  xPos = 0.25,
  yPos = 0.25,
  nestSize = size03,
)
nest004 = nest(
  cubeFace = rectangleSegmentA001,
  xPos = 0.25,
  yPos = 0.75,
  nestSize = size03,
)

// Model each nest on side 2
nest005 = nest(
  cubeFace = rectangleSegmentB001,
  xPos = 0.7,
  yPos = 0.3,
  nestSize = size04,
)
nest006 = nest(
  cubeFace = rectangleSegmentB001,
  xPos = 0.25,
  yPos = 0.3,
  nestSize = size05,
)
nest007 = nest(
  cubeFace = rectangleSegmentB001,
  xPos = 0.25,
  yPos = 0.7,
  nestSize = size05,
)
nest008 = nest(
  cubeFace = rectangleSegmentB001,
  xPos = 0.7,
  yPos = 0.7,
  nestSize = size05,
)

// Model each nest on side 3
nest009 = nest(
  cubeFace = rectangleSegmentC001,
  xPos = -0.5,
  yPos = 0.5,
  nestSize = size06,
)

// Model each nest on side 4
nest010 = nest(
  cubeFace = rectangleSegmentD001,
  xPos = -0.2,
  yPos = 0.2,
  nestSize = size15,
)
nest011 = nest(
  cubeFace = rectangleSegmentD001,
  xPos = -0.2,
  yPos = 0.5,
  nestSize = size14,
)
nest012 = nest(
  cubeFace = rectangleSegmentD001,
  xPos = -0.2,
  yPos = 0.8,
  nestSize = size13,
)
nest013 = nest(
  cubeFace = rectangleSegmentD001,
  xPos = -0.8,
  yPos = 0.2,
  nestSize = size12,
)
nest014 = nest(
  cubeFace = rectangleSegmentD001,
  xPos = -0.8,
  yPos = 0.5,
  nestSize = size10,
)
nest015 = nest(
  cubeFace = rectangleSegmentD001,
  xPos = -0.8,
  yPos = 0.8,
  nestSize = size08,
)
nest016 = nest(
  cubeFace = rectangleSegmentD001,
  xPos = -0.5,
  yPos = 0.33,
  nestSize = size09,
)
nest017 = nest(
  cubeFace = rectangleSegmentD001,
  xPos = -0.5,
  yPos = 0.67,
  nestSize = size11,
)

// Model each nest on the bottom face
nest018 = nest(
  cubeFace = START,
  xPos = -0.5,
  yPos = 0.5,
  nestSize = size07,
)

// Each subtraction consumes its target; pass the resulting solid to the next cut.
cut001 = subtract(cubeExtrude, tools = [nest001])
cut002 = subtract(cut001, tools = [nest002])
cut003 = subtract(cut002, tools = [nest003])
cut004 = subtract(cut003, tools = [nest004])
cut005 = subtract(cut004, tools = [nest005])
cut006 = subtract(cut005, tools = [nest006])
cut007 = subtract(cut006, tools = [nest007])
cut008 = subtract(cut007, tools = [nest008])
cut009 = subtract(cut008, tools = [nest009])
cut010 = subtract(cut009, tools = [nest010])
cut011 = subtract(cut010, tools = [nest011])
cut012 = subtract(cut011, tools = [nest012])
cut013 = subtract(cut012, tools = [nest013])
cut014 = subtract(cut013, tools = [nest014])
cut015 = subtract(cut014, tools = [nest015])
cut016 = subtract(cut015, tools = [nest016])
cut017 = subtract(cut016, tools = [nest017])
cut018 = subtract(cut017, tools = [nest018])
