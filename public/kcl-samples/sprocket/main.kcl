// Sprocket
// A 28-tooth hub sprocket for #25 roller chain with a center bore and lightening holes.
// Categories: Manufacturing, Automotive

@settings(defaultLengthUnit = in, kclVersion = 2.0, experimentalFeatures = allow)

chainPitch = 1 / 4
rollerWidth = 1 / 8
rollerDiameter = 0.13

fn sprocket(@nTeeth, boreDiameter) {
  pitchDiameter = chainPitch / sin(180deg / nTeeth)
  module = pitchDiameter / nTeeth
  thickness = rollerWidth * 0.9

  toothedBody = gear::spur(
    nTeeth,
    module,
    pressureAngle = 20deg,
    gearHeight = thickness,
  )

  boreSketch = sketch(on = XY) {
    bore = circle(start = [var 0.3125in, var 0in], center = [var 0in, var 0in])
  }
  bore = extrude(region(segments = [boreSketch.bore]), length = thickness)
  boredBody = subtract(toothedBody, tools = [bore])

  holePosition = (pitchDiameter - (rollerDiameter / 2) + boreDiameter) / 4
  holeRadius = holePosition / 4.5
  holeSketch = sketch(on = XY) {
    hole = circle(start = [var 0.155in, var 0.698in], center = [var 0in, var 0.698in])
  }
  hole = extrude(region(segments = [holeSketch.hole]), length = thickness)
    |> patternCircular3d(
         instances = 6,
         axis = Z,
         center = [0, 0, 0],
         arcDegrees = 360deg,
         rotateDuplicates = false,
       )

  result = subtract(boredBody, tools = hole)
  hide(boreSketch)
  hide(holeSketch)
  return result
}

sprocket(28, boreDiameter = 5 / 8)
