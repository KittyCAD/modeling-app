blankRegion = region(segments = [outlineSketch.segment000])
blank = extrude(blankRegion, length = thickness)

// The bore and four lightening holes retain the original calculated dimensions.
cutSketch = sketch(on = XY) {
  bore = circle(start = [boreDiameter / 2, 0in], center = [0in, 0in])
  lighteningHole1 = circle(
    start = [
      lighteningHoleDiameter / 2,
      lighteningHolePosition
    ],
    center = [0in, lighteningHolePosition],
  )
  lighteningHole2 = circle(
    start = [
      -lighteningHolePosition + lighteningHoleDiameter / 2,
      0in
    ],
    center = [-lighteningHolePosition, 0in],
  )
  lighteningHole3 = circle(
    start = [
      lighteningHoleDiameter / 2,
      -lighteningHolePosition
    ],
    center = [0in, -lighteningHolePosition],
  )
  lighteningHole4 = circle(
    start = [
      lighteningHolePosition + lighteningHoleDiameter / 2,
      0in
    ],
    center = [lighteningHolePosition, 0in],
  )
}

boreRegion = region(segments = [cutSketch.bore])
lighteningHoleRegion1 = region(segments = [cutSketch.lighteningHole1])
lighteningHoleRegion2 = region(segments = [cutSketch.lighteningHole2])
lighteningHoleRegion3 = region(segments = [cutSketch.lighteningHole3])
lighteningHoleRegion4 = region(segments = [cutSketch.lighteningHole4])
cutters = extrude(
  [
    boreRegion,
    lighteningHoleRegion1,
    lighteningHoleRegion2,
    lighteningHoleRegion3,
    lighteningHoleRegion4
  ],
  length = thickness,
)
sprocket = subtract(blank, tools = cutters)

// Match the historical XZ sketch orientation.
rotate(sprocket, roll = 90deg, global = true)
hide(outlineSketch)
hide(cutSketch)
