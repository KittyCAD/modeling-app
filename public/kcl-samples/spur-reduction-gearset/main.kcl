// Spur Reduction Gearset
// A pair of meshed spur gears with equal module and different tooth counts.
// Categories: Automotive, Aerospace

@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

fn boredSpurGear(@nTeeth, gearHeight) {
  body = gear::spur(
    nTeeth,
    module = 1.5,
    pressureAngle = 14deg,
    gearHeight,
  )
  boreSketch = sketch(on = XY) {
    bore = circle(start = [var 5mm, var 0mm], center = [var 0mm, var 0mm])
    coincident([bore.center, ORIGIN])
    radius(bore) == 5mm
  }
  bore = extrude(region(segments = [boreSketch.bore]), length = gearHeight)
  result = subtract(body, tools = [bore])
  hide(boreSketch)
  return result
}

smallGear = boredSpurGear(17, gearHeight = 9)
largeGear = boredSpurGear(51, gearHeight = 7)
  |> translate(x = (51 + 17) / 2 * 1.5 + 1.3)
  |> rotate(yaw = 3deg)
