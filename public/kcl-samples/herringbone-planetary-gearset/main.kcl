// Herringbone Planetary Gearset
// A herringbone planetary set with a sun gear, four planets, and an internally toothed ring.
// Categories: Automotive, Aerospace

@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

gearHeight = 8
module = 1.5
pressureAngle = 14deg

fn boredHerringbone(@nTeeth, helixAngle) {
  body = gear::herringbone(
    nTeeth,
    module,
    pressureAngle,
    helixAngle,
    gearHeight,
  )
  boreSketch = sketch(on = XY) {
    bore = circle(start = [var 4mm, var 0mm], center = [var 0mm, var 0mm])
    coincident([bore.center, ORIGIN])
    radius(bore) == 4mm
  }
  bore = extrude(region(segments = [boreSketch.bore]), length = gearHeight)
  result = subtract(body, tools = [bore])
  hide(boreSketch)
  return result
}

// Opposing helical halves form the herringbone ring.
ringLower = gear::ring(
  nTeeth = 58,
  module,
  pressureAngle,
  helixAngle = -35deg,
  gearHeight = gearHeight / 2,
)
ringUpper = gear::ring(
  nTeeth = 58,
  module,
  pressureAngle,
  helixAngle = 35deg,
  gearHeight = gearHeight / 2,
)
  |> translate(z = gearHeight / 2)

sunGear = boredHerringbone(18, helixAngle = 35deg)

planetGear = boredHerringbone(18, helixAngle = -35deg)
  |> translate(y = 18 * module + 1.95)
  |> patternCircular3d(
       instances = 4,
       axis = Z,
       center = [0, 0, 0],
       arcDegrees = 360deg,
       rotateDuplicates = false,
     )
