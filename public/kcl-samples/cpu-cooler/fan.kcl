// Fan
// Spinning axial fan that moves airflow

// Set units
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

// Import parameters
import * from "parameters.kcl"

// Model the center of the fan
sketch001 = sketch(on = YZ) {
  circle1 = circle(start = [var 12.5mm, var 0mm], center = [var 0mm, var 0mm])
}
region001 = region(segments = [sketch001.circle1])
fanCenter = extrude(region001, length = fanHeight)

// Build one blade as a constrained KCL 2 region, then pattern it about the hub.
bladeSketch = sketch(on = offsetPlane(YZ, offset = 4.5)) {
  line1 = line(start = [var 12mm, var 8mm], end = [var 50mm, var 4mm])
  line2 = line(start = [var 50mm, var 4mm], end = [var 45mm, var 15mm])
  coincident([line1.end, line2.start])
  line3 = line(start = [var 45mm, var 15mm], end = [var 14mm, var 14mm])
  coincident([line2.end, line3.start])
  line4 = line(start = [var 14mm, var 14mm], end = [var 12mm, var 8mm])
  coincident([line3.end, line4.start])
}
bladeRegion = region(segments = [bladeSketch.line1, bladeSketch.line2])
bladeLoft = extrude(bladeRegion, length = fanHeight - 6.5)
  |> patternCircular3d(
       instances = 9,
       axis = [1, 0, 0],
       center = [0, 0, 0],
       arcDegrees = 360deg,
       rotateDuplicates = true,
     )

[fanCenter, bladeLoft]
  |> appearance(color = "#110803")
