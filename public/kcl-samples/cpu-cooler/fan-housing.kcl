// Fan Housing
// The plastic housing that contains the fan and the motor

@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import * from "parameters.kcl"

housingSketch = sketch(on = YZ) {
  line1 = line(start = [var -60mm, var -60mm], end = [var 60mm, var -60mm])
  line2 = line(start = [var 60mm, var -60mm], end = [var 60mm, var 60mm])
  coincident([line1.end, line2.start])
  line3 = line(start = [var 60mm, var 60mm], end = [var -60mm, var 60mm])
  coincident([line2.end, line3.start])
  line4 = line(start = [var -60mm, var 60mm], end = [var -60mm, var -60mm])
  coincident([line3.end, line4.start])
}
housingBlank = extrude(
  region(segments = [
    housingSketch.line1,
    housingSketch.line2
  ]),
  length = fanHeight,
)

airflowSketch = sketch(on = YZ) {
  opening = circle(start = [var 55mm, var 0mm], center = [var 0mm, var 0mm])
}
airflowCutter = extrude(region(segments = [airflowSketch.opening]), length = fanHeight)
housing = subtract(housingBlank, tools = [airflowCutter])

mountSketch = sketch(on = YZ) {
  hole = circle(start = [var 54.75mm, var 52.5mm], center = [var 52.5mm, var 52.5mm])
}
mountCutter = extrude(region(segments = [mountSketch.hole]), length = fanHeight)
  |> patternCircular3d(
       instances = 4,
       axis = X,
       center = [0, 0, 0],
       arcDegrees = 360deg,
       rotateDuplicates = true,
     )
housingWithMounts = subtract(housing, tools = mountCutter)

motorSketch = sketch(on = YZ) {
  boss = circle(start = [var 11.2mm, var 0mm], center = [var 0mm, var 0mm])
}
motorHousing = extrude(region(segments = [motorSketch.boss]), length = 16)

[housingWithMounts, motorHousing]
  |> appearance(color = "#a55e2c")
