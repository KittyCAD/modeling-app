// Spur Gear
// A 21-tooth involute spur gear with a keyed center bore.
// Categories: Automotive, Aerospace

@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

gearHeight = 6
gearBody = gear::spur(
  nTeeth = 21,
  module = 1.5,
  pressureAngle = 14deg,
  gearHeight,
)

boreSketch = sketch(on = XY) {
  bore = circle(start = [var 2.5mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([bore.center, ORIGIN])
  radius(bore) == 2.5mm
}
keywaySketch = sketch(on = XY) {
  keywayTop = line(start = [var 2mm, var 1mm], end = [var 3mm, var 1mm])
  keywayOuter = line(start = [var 3mm, var 1mm], end = [var 3mm, var -1mm])
  coincident([keywayTop.end, keywayOuter.start])
  keywayBottom = line(start = [var 3mm, var -1mm], end = [var 2mm, var -1mm])
  coincident([keywayOuter.end, keywayBottom.start])
  keywayInner = line(start = [var 2mm, var -1mm], end = [var 2mm, var 1mm])
  coincident([keywayBottom.end, keywayInner.start])
  coincident([keywayInner.end, keywayTop.start])
}
bore = extrude(region(segments = [boreSketch.bore]), length = gearHeight)
keyway = extrude(
  region(segments = [
    keywaySketch.keywayTop,
    keywaySketch.keywayOuter,
    keywaySketch.keywayBottom,
    keywaySketch.keywayInner
  ]),
  length = gearHeight,
)
spurGear = subtract(gearBody, tools = [bore, keyway])
hide(boreSketch)
hide(keywaySketch)
