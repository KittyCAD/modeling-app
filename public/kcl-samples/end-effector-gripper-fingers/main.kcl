  coincident([line12.end, line13.start])
  line14 = line(start = [var 12mm, var 207.941545093mm], end = [var 8.9mm, var 207.941545093mm])
  coincident([line13.end, line14.start])
  line15 = line(start = [var 8.9mm, var 207.941545093mm], end = [var 8.9mm, var 212.941545093mm])
  coincident([line14.end, line15.start])
  line16 = line(start = [var 8.9mm, var 212.941545093mm], end = [var 4.1mm, var 212.941545093mm])
  coincident([line15.end, line16.start])
  line17 = line(start = [var 4.1mm, var 212.941545093mm], end = [var 4.1mm, var 207.941545093mm])
  coincident([line16.end, line17.start])
  line18 = line(start = [var 4.1mm, var 207.941545093mm], end = [var 0mm, var 207.941545093mm])
  coincident([line17.end, line18.start])
  coincident([line18.end, line1.start])
}
region009 = region(segments = [sketch009.line1, sketch009.line2])
gripperPins = revolve(
  region009,
  axis = {
    direction = [1.0, 0.0],
    origin = [0.0, 140 + linkLength * sin(linkAngle)]
  },
)
  |> patternLinear3d(instances = 2, distance = 40, axis = [1, 0, 0])
  |> appearance(color = "#a6a6a6")

hide([
  sketch1,
  sketch2,
  sketch3,
  sketch4,
  sketch5,
  sketch2ForHousing,
  sketch4ForUpperTrim,
  sketch001,
  hole01,
  hole02,
  hole03,
  hole04,
  sketch002,
  linkageHoleSketch,
  sketch003,
  sketch004,
  sketch005,
  sketch006,
  sketch007,
  sketch008,
  sketch009
])

// Pattern 3 each item around the center so that the hand has 3 fingers
[
  bracket,
  linkageBar,
  gripper,
  basePins,
  gripperPins
]
  |> patternCircular3d(
       instances = 3,
       axis = [0, 0, 1],
       center = [0, 0, 0],
       arcDegrees = 360,
       rotateDuplicates = true,
     )
