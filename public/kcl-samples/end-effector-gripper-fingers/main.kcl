// Loft consumes its section paths, so emit independent copies at the two
// planes shared by adjacent lofts, matching the legacy clone sketch intent.
sketch2ForHousing = sketch(on = offsetPlane(XY, offset = 20)) {
  line1 = line(start = [var 50mm, var -5mm], end = [var 50mm, var 5mm])
  arc2 = arc(start = [var 50mm, var 5mm], end = [var 46mm, var 11.92820323mm], center = [var 42mm, var 5mm])
  coincident([line1.end, arc2.start])
  line3 = line(start = [var 46mm, var 11.92820323mm], end = [var -18.951905284mm, var 49.42820323mm])
  coincident([arc2.end, line3.start])
  arc4 = arc(start = [var -18.951905284mm, var 49.42820323mm], end = [var -26.951905284mm, var 49.42820323mm], center = [var -22.951905284mm, var 42.5mm])
  coincident([line3.end, arc4.start])
  line5 = line(start = [var -26.951905284mm, var 49.42820323mm], end = [var -35.612159322mm, var 44.42820323mm])
  coincident([arc4.end, line5.start])
  arc6 = arc(start = [var -35.612159322mm, var 44.42820323mm], end = [var -39.612159322mm, var 37.5mm], center = [var -31.612159322mm, var 37.5mm])
  coincident([line5.end, arc6.start])
  line7 = line(start = [var -39.612159322mm, var 37.5mm], end = [var -39.612159322mm, var -37.5mm])
  coincident([arc6.end, line7.start])
  arc8 = arc(
    start = [var -39.612159322mm, var -37.5mm],
    end = [
      var -35.612159322mm,
      var -44.42820323mm
    ],
    center = [var -31.612159322mm, var -37.5mm],
  )
  coincident([line7.end, arc8.start])
  line9 = line(
    start = [
      var -35.612159322mm,
