// End Effector Grippers
// End effector grippers are devices attached to a robot's arm that allow it to interact with its environment and perform tasks like picking up, moving, and manipulating objects. They are essential for robots to perform useful work. Grippers are one type of end effector, but end effectors can also be tools like welding torches or cameras
// Categories: Manufacturing

// Set units
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

tol = 0.001

// Define sheet metal parameters
bracketThickness = 3
bracketBendRadius = 3.75

// Define linkage parameters
linkRadius = 8
linkLength = 70
linkAngle = 65deg

// Model the five body sections as explicit solved profiles.
sketch1 = sketch(on = offsetPlane(XY, offset = 0)) {
  line1 = line(start = [var 40mm, var -4mm], end = [var 40mm, var 4mm])
  arc2 = arc(start = [var 40mm, var 4mm], end = [var 36mm, var 10.92820323mm], center = [var 32mm, var 4mm])
  coincident([line1.end, arc2.start])
  line3 = line(start = [var 36mm, var 10.92820323mm], end = [var -15.961524227mm, var 40.92820323mm])
  coincident([arc2.end, line3.start])
  arc4 = arc(start = [var -15.961524227mm, var 40.92820323mm], end = [var -23.961524227mm, var 40.92820323mm], center = [var -19.961524227mm, var 34mm])
  coincident([line3.end, arc4.start])
  line5 = line(start = [var -23.961524227mm, var 40.92820323mm], end = [var -30.889727457mm, var 36.92820323mm])
  coincident([arc4.end, line5.start])
  arc6 = arc(start = [var -30.889727457mm, var 36.92820323mm], end = [var -34.889727457mm, var 30mm], center = [var -26.889727457mm, var 30mm])
  coincident([line5.end, arc6.start])
  line7 = line(start = [var -34.889727457mm, var 30mm], end = [var -34.889727457mm, var -30mm])
  coincident([arc6.end, line7.start])
  arc8 = arc(
    start = [var -34.889727457mm, var -30mm],
    end = [
      var -30.889727457mm,
      var -36.92820323mm
    ],
    center = [var -26.889727457mm, var -30mm],
  )
  coincident([line7.end, arc8.start])
  line9 = line(
    start = [
      var -30.889727457mm,
      var -36.92820323mm
    ],
    end = [
      var -23.961524227mm,
      var -40.92820323mm
    ],
  )
  coincident([arc8.end, line9.start])
  arc10 = arc(
    start = [
      var -23.961524227mm,
      var -40.92820323mm
    ],
    end = [
      var -15.961524227mm,
      var -40.92820323mm
    ],
    center = [var -19.961524227mm, var -34mm],
  )
  coincident([line9.end, arc10.start])
  line11 = line(
    start = [
      var -15.961524227mm,
      var -40.92820323mm
    ],
    end = [var 36mm, var -10.92820323mm],
  )
  coincident([arc10.end, line11.start])
  arc12 = arc(start = [var 36mm, var -10.92820323mm], end = [var 40mm, var -4mm], center = [var 32mm, var -4mm])
  coincident([line11.end, arc12.start])
  coincident([arc12.end, line1.start])
}

