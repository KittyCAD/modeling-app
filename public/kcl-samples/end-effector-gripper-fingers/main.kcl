  )
  coincident([line7.end, arc8.start])
  line9 = line(
    start = [
      var -61.585534576mm,
      var -85.67820323mm
    ],
    end = [
      var -43.399001096mm,
      var -96.17820323mm
    ],
  )
  coincident([arc8.end, line9.start])
  arc10 = arc(
    start = [
      var -43.399001096mm,
      var -96.17820323mm
    ],
    end = [
      var -35.399001096mm,
      var -96.17820323mm
    ],
