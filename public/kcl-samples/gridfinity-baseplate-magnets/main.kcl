// Gridfinity Baseplate With Magnets
// A two-by-three Gridfinity baseplate profile, ready for magnetic bin retention.
// Categories: Maker

// Set units in millimeters (mm)
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

binLength = 42.0
cornerRadius = 4.0
firstStep = 0.7
secondStep = 1.8
thirdStep = 2.15
magOuterDiam = 6.5
magDepth = 2.4

countBinWidth = 2
countBinLength = 3

height = firstStep + secondStep + thirdStep

baseFacePlane = offsetPlane(YZ, offset = cornerRadius)
baseFaceSketch = sketch(on = baseFacePlane) {
  line1 = line(start = [var 0mm, var 0mm], end = [var 0mm, var 4.65mm])
  line2 = line(start = [var 0mm, var 4.65mm], end = [var 2.15mm, var 2.5mm])
  coincident([line1.end, line2.start])
  line3 = line(start = [var 2.15mm, var 2.5mm], end = [var 2.15mm, var 0.7mm])
  coincident([line2.end, line3.start])
  line4 = line(start = [var 2.15mm, var 0.7mm], end = [var 2.85mm, var 0mm])
  coincident([line3.end, line4.start])
  line5 = line(start = [var 2.85mm, var 0mm], end = [var 0mm, var 0mm])
  coincident([line4.end, line5.start])
  coincident([line5.end, line1.start])
  coincident([line1.start, ORIGIN])
  guide1 = line(start = [var 0mm, var 0mm], end = [var 2.15mm, var 0mm], construction = true)
  coincident([guide1.start, line1.start])
  guide2 = line(start = [var 2.15mm, var 0mm], end = [var 2.15mm, var 2.5mm], construction = true)
  coincident([guide1.end, guide2.start])
  coincident([guide2.end, line2.end])
  guide3 = line(start = [var 0mm, var 0mm], end = [var 2.85mm, var 0mm], construction = true)
  coincident([guide3.start, line1.start])
  coincident([guide3.end, line4.end])
  guide4 = line(start = [var 2.15mm, var 0mm], end = [var 2.15mm, var 0.7mm], construction = true)
  coincident([guide4.start, guide1.end])
  coincident([guide4.end, line3.end])
  vertical(line1)
  vertical(line3)
  horizontal(guide1)
  vertical(guide2)
  horizontal(guide3)
  vertical(guide4)
  distance([line1.start, line1.end]) == height
  distance([guide1.start, guide1.end]) == thirdStep
  distance([guide2.start, guide2.end]) == firstStep + secondStep
  distance([guide3.start, guide3.end]) == thirdStep + firstStep
  distance([guide4.start, guide4.end]) == firstStep
}
baseFaceRegion = region(segments = [baseFaceSketch.line1])
singleSide = extrude(baseFaceRegion, length = binLength - (cornerRadius * 2))

sides = patternCircular3d(
  singleSide,
  arcDegrees = 360deg,
  axis = [0, 0, 1],
  center = [binLength / 2, binLength / 2, 0],
  instances = 4,
  rotateDuplicates = true,
)

axis000 = {
  direction = [0.0, 1.0],
  origin = [cornerRadius, cornerRadius]
}

cornerFaceRegion = region(segments = [baseFaceSketch.line1])
singleCorner = revolve(cornerFaceRegion, angle = -90deg, axis = axis000)
hide(baseFaceSketch)

corners = patternCircular3d(
  singleCorner,
  arcDegrees = 360deg,
  axis = [0, 0, 1],
  center = [binLength / 2, binLength / 2, 0],
  instances = 4,
  rotateDuplicates = true,
)

basePlateSides = patternLinear3d(
  sides,
  axis = [1.0, 0.0, 0.0],
  instances = countBinWidth,
  distance = binLength,
)
  |> patternLinear3d(axis = [0.0, 1.0, 0.0], instances = countBinLength, distance = binLength)

basePlateCorners = patternLinear3d(
  corners,
  axis = [1.0, 0.0, 0.0],
  instances = countBinWidth,
  distance = binLength,
)
  |> patternLinear3d(axis = [0.0, 1.0, 0.0], instances = countBinLength, distance = binLength)

// Recreate the two legacy magnet-base layers. The first layer has four
// magnet bores per cell; the lower layer retains the same rounded center
// opening without those bores.
magnetBaseSketch = sketch(on = XY) {
  bottomEdge = line(start = [var 0mm, var 0mm], end = [var 42mm, var 0mm])
  rightEdge = line(start = [var 42mm, var 0mm], end = [var 42mm, var 42mm])
  topEdge = line(start = [var 42mm, var 42mm], end = [var 0mm, var 42mm])
  leftEdge = line(start = [var 0mm, var 42mm], end = [var 0mm, var 0mm])
  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  coincident([bottomEdge.start, ORIGIN])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  distance([bottomEdge.start, bottomEdge.end]) == binLength
  distance([rightEdge.start, rightEdge.end]) == binLength

  centerLine1 = line(start = [var 2.85mm, var 13mm], end = [var 2.85mm, var 29mm])
  centerLine2 = line(start = [var 2.85mm, var 29mm], end = [var 9.75mm, var 29mm])
  centerArc3 = arc(start = [var 9.75mm, var 29mm], end = [var 13mm, var 32.25mm], center = [var 9.75mm, var 32.25mm])
  centerLine4 = line(start = [var 13mm, var 32.25mm], end = [var 13mm, var 39.15mm])
  centerLine5 = line(start = [var 13mm, var 39.15mm], end = [var 29mm, var 39.15mm])
  centerLine6 = line(start = [var 29mm, var 39.15mm], end = [var 29mm, var 32.25mm])
  centerArc7 = arc(start = [var 29mm, var 32.25mm], end = [var 32.25mm, var 29mm], center = [var 32.25mm, var 32.25mm])
  centerLine8 = line(start = [var 32.25mm, var 29mm], end = [var 39.15mm, var 29mm])
  centerLine9 = line(start = [var 39.15mm, var 29mm], end = [var 39.15mm, var 13mm])
  centerLine10 = line(start = [var 39.15mm, var 13mm], end = [var 32.25mm, var 13mm])
  centerArc11 = arc(start = [var 32.25mm, var 13mm], end = [var 29mm, var 9.75mm], center = [var 32.25mm, var 9.75mm])
  centerLine12 = line(start = [var 29mm, var 9.75mm], end = [var 29mm, var 2.85mm])
  centerLine13 = line(start = [var 29mm, var 2.85mm], end = [var 13mm, var 2.85mm])
  centerLine14 = line(start = [var 13mm, var 2.85mm], end = [var 13mm, var 9.75mm])
  centerArc15 = arc(start = [var 13mm, var 9.75mm], end = [var 9.75mm, var 13mm], center = [var 9.75mm, var 9.75mm])
  centerLine16 = line(start = [var 9.75mm, var 13mm], end = [var 2.85mm, var 13mm])
  coincident([centerLine1.end, centerLine2.start])
  coincident([centerLine2.end, centerArc3.start])
  coincident([centerArc3.end, centerLine4.start])
  coincident([centerLine4.end, centerLine5.start])
  coincident([centerLine5.end, centerLine6.start])
  coincident([centerLine6.end, centerArc7.start])
  coincident([centerArc7.end, centerLine8.start])
  coincident([centerLine8.end, centerLine9.start])
  coincident([centerLine9.end, centerLine10.start])
  coincident([centerLine10.end, centerArc11.start])
  coincident([centerArc11.end, centerLine12.start])
  coincident([centerLine12.end, centerLine13.start])
  coincident([centerLine13.end, centerLine14.start])
  coincident([centerLine14.end, centerArc15.start])
  coincident([centerArc15.end, centerLine16.start])
  coincident([centerLine16.end, centerLine1.start])

  bore1 = circle(start = [var 11.25mm, var 8mm], center = [var 8mm, var 8mm])
  bore2 = circle(start = [var 37.25mm, var 8mm], center = [var 34mm, var 8mm])
  bore3 = circle(start = [var 37.25mm, var 34mm], center = [var 34mm, var 34mm])
  bore4 = circle(start = [var 11.25mm, var 34mm], center = [var 8mm, var 34mm])
  radius(bore1) == magOuterDiam / 2
  radius(bore2) == magOuterDiam / 2
  radius(bore3) == magOuterDiam / 2
  radius(bore4) == magOuterDiam / 2
}
magnetBaseRegion = region(segments = [
  magnetBaseSketch.bottomEdge,
  magnetBaseSketch.rightEdge
])

magnetLayerCut = extrude(magnetBaseRegion, length = -magDepth)
magnetLayer = fillet(
  magnetLayerCut,
  radius = cornerRadius,
  tags = [
    getCommonEdge(faces = [
      magnetBaseRegion.tags.bottomEdge,
      magnetBaseRegion.tags.rightEdge
    ]),
    getCommonEdge(faces = [
      magnetBaseRegion.tags.rightEdge,
      magnetBaseRegion.tags.topEdge
    ]),
    getCommonEdge(faces = [
      magnetBaseRegion.tags.topEdge,
      magnetBaseRegion.tags.leftEdge
    ]),
    getCommonEdge(faces = [
      magnetBaseRegion.tags.leftEdge,
      magnetBaseRegion.tags.bottomEdge
    ])
  ],
)
magnetLayers = patternLinear3d(
  magnetLayer,
  axis = [1.0, 0.0, 0.0],
  instances = countBinWidth,
  distance = binLength,
)
  |> patternLinear3d(axis = [0.0, 1.0, 0.0], instances = countBinLength, distance = binLength)

lowerMagnetBaseSketch = sketch(on = offsetPlane(XY, offset = -magDepth)) {
  bottomEdge = line(start = [var 0mm, var 0mm], end = [var 42mm, var 0mm])
  rightEdge = line(start = [var 42mm, var 0mm], end = [var 42mm, var 42mm])
  topEdge = line(start = [var 42mm, var 42mm], end = [var 0mm, var 42mm])
  leftEdge = line(start = [var 0mm, var 42mm], end = [var 0mm, var 0mm])
  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])

  centerLine1 = line(start = [var 2.85mm, var 13mm], end = [var 2.85mm, var 29mm])
  centerLine2 = line(start = [var 2.85mm, var 29mm], end = [var 9.75mm, var 29mm])
  centerArc3 = arc(start = [var 9.75mm, var 29mm], end = [var 13mm, var 32.25mm], center = [var 9.75mm, var 32.25mm])
  centerLine4 = line(start = [var 13mm, var 32.25mm], end = [var 13mm, var 39.15mm])
  centerLine5 = line(start = [var 13mm, var 39.15mm], end = [var 29mm, var 39.15mm])
  centerLine6 = line(start = [var 29mm, var 39.15mm], end = [var 29mm, var 32.25mm])
  centerArc7 = arc(start = [var 29mm, var 32.25mm], end = [var 32.25mm, var 29mm], center = [var 32.25mm, var 32.25mm])
  centerLine8 = line(start = [var 32.25mm, var 29mm], end = [var 39.15mm, var 29mm])
  centerLine9 = line(start = [var 39.15mm, var 29mm], end = [var 39.15mm, var 13mm])
  centerLine10 = line(start = [var 39.15mm, var 13mm], end = [var 32.25mm, var 13mm])
  centerArc11 = arc(start = [var 32.25mm, var 13mm], end = [var 29mm, var 9.75mm], center = [var 32.25mm, var 9.75mm])
  centerLine12 = line(start = [var 29mm, var 9.75mm], end = [var 29mm, var 2.85mm])
  centerLine13 = line(start = [var 29mm, var 2.85mm], end = [var 13mm, var 2.85mm])
  centerLine14 = line(start = [var 13mm, var 2.85mm], end = [var 13mm, var 9.75mm])
  centerArc15 = arc(start = [var 13mm, var 9.75mm], end = [var 9.75mm, var 13mm], center = [var 9.75mm, var 9.75mm])
  centerLine16 = line(start = [var 9.75mm, var 13mm], end = [var 2.85mm, var 13mm])
  coincident([centerLine1.end, centerLine2.start])
  coincident([centerLine2.end, centerArc3.start])
  coincident([centerArc3.end, centerLine4.start])
  coincident([centerLine4.end, centerLine5.start])
  coincident([centerLine5.end, centerLine6.start])
  coincident([centerLine6.end, centerArc7.start])
  coincident([centerArc7.end, centerLine8.start])
  coincident([centerLine8.end, centerLine9.start])
  coincident([centerLine9.end, centerLine10.start])
  coincident([centerLine10.end, centerArc11.start])
  coincident([centerArc11.end, centerLine12.start])
  coincident([centerLine12.end, centerLine13.start])
  coincident([centerLine13.end, centerLine14.start])
  coincident([centerLine14.end, centerArc15.start])
  coincident([centerArc15.end, centerLine16.start])
  coincident([centerLine16.end, centerLine1.start])
}
lowerMagnetBaseRegion = region(segments = [
  lowerMagnetBaseSketch.bottomEdge,
  lowerMagnetBaseSketch.rightEdge
])
lowerMagnetBaseCut = extrude(lowerMagnetBaseRegion, length = -magDepth)
lowerMagnetBase = fillet(
  lowerMagnetBaseCut,
  radius = cornerRadius,
  tags = [
    getCommonEdge(faces = [
      lowerMagnetBaseRegion.tags.bottomEdge,
      lowerMagnetBaseRegion.tags.rightEdge
    ]),
    getCommonEdge(faces = [
      lowerMagnetBaseRegion.tags.rightEdge,
      lowerMagnetBaseRegion.tags.topEdge
    ]),
    getCommonEdge(faces = [
      lowerMagnetBaseRegion.tags.topEdge,
      lowerMagnetBaseRegion.tags.leftEdge
    ]),
    getCommonEdge(faces = [
      lowerMagnetBaseRegion.tags.leftEdge,
      lowerMagnetBaseRegion.tags.bottomEdge
    ])
  ],
)
lowerMagnetBases = patternLinear3d(
  lowerMagnetBase,
  axis = [1.0, 0.0, 0.0],
  instances = countBinWidth,
  distance = binLength,
)
  |> patternLinear3d(axis = [0.0, 1.0, 0.0], instances = countBinLength, distance = binLength)

hide([
  magnetBaseSketch,
  lowerMagnetBaseSketch
])
