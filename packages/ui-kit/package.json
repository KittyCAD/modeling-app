{
  "name": "@kittycad/ui-kit",
  "version": "0.1.0",
  "description": "Design system and UI building blocks for Zoo Design Studio. Preact + signals.",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
