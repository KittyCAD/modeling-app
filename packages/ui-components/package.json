{
  "name": "@kittycad/ui-components",
  "version": "0.1.0",
  "description": "Component library workspace for Zoo Design Studio.",
  "type": "module",
  "repository": "https://github.com/KittyCAD/modeling-app",
  "author": "Zoo Engineering Team",
  "license": "MIT",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-components": {
      "types": "./dist/web-components/index.d.ts",
      "import": "./dist/web-components.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:types && vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006 --config-dir .storybook",
    "build-storybook": "storybook build --config-dir .storybook",
    "storybook:web-components": "storybook dev -p 6007 --config-dir .storybook-web-components",
    "typecheck:web-components": "tsc -p .storybook-web-components/tsconfig.json --noEmit",
    "build-storybook:web-components": "storybook build --config-dir .storybook-web-components --output-dir storybook-web-components-static",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:properties": "vitest run --project component src/web-components/feature-tree/feature-tree.properties.test.ts",
    "test:browser": "playwright test --config playwright.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@kittycad/lib": "^4.5.35",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "lit": "^3.3.3",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@storybook/web-components-vite": "10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/ms": "^2.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "msw": "^2.14.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.6",
    "typescript": "7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
