        chordFraction = station,
        maxCamber = maxCamber,
        camberPosition = camberPosition,
        thicknessRatio = thicknessRatio,
        surfaceSign = -1,
      )
    },
  )
  intervalIndexes = [0, 1, 2, 3, 4, 5, 6, 7]
  upperBiarcs = map(
    intervalIndexes,
    f = fn(@index) {
      return balancedBiarc(
        point0 = upperData[index].point,
        tangent0 = upperData[index].tangent,
        point1 = upperData[index + 1].point,
        tangent1 = upperData[index + 1].tangent,
      )
    },
  )
  lowerBiarcs = map(
    intervalIndexes,
    f = fn(@index) {
      return balancedBiarc(
        point0 = lowerData[index].point,
        tangent0 = lowerData[index].tangent,
        point1 = lowerData[index + 1].point,
        tangent1 = lowerData[index + 1].tangent,
      )
    },
  )
