    verticalDistance([ORIGIN, upperCrownB.center]) == upperBiarcs[4].secondCenter.y * chordLength
    verticalDistance([ORIGIN, upperMidA.center]) == upperBiarcs[5].firstCenter.y * chordLength
    verticalDistance([ORIGIN, upperMidB.center]) == upperBiarcs[5].secondCenter.y * chordLength
    verticalDistance([ORIGIN, upperRearA.center]) == upperBiarcs[6].firstCenter.y * chordLength
    verticalDistance([ORIGIN, upperRearB.center]) == upperBiarcs[6].secondCenter.y * chordLength
    verticalDistance([ORIGIN, upperTailA.center]) == upperBiarcs[7].firstCenter.y * chordLength
    verticalDistance([ORIGIN, upperTailB.center]) == upperBiarcs[7].secondCenter.y * chordLength
    horizontalDistance([ORIGIN, lowerLeadA.center]) == lowerBiarcs[0].firstCenter.x * chordLength
    horizontalDistance([ORIGIN, lowerLeadB.center]) == lowerBiarcs[0].secondCenter.x * chordLength
    verticalDistance([ORIGIN, lowerNoseA.center]) == lowerBiarcs[1].firstCenter.y * chordLength
    verticalDistance([ORIGIN, lowerNoseB.center]) == lowerBiarcs[1].secondCenter.y * chordLength
    verticalDistance([ORIGIN, lowerFrontA.center]) == lowerBiarcs[2].firstCenter.y * chordLength
    verticalDistance([ORIGIN, lowerFrontB.center]) == lowerBiarcs[2].secondCenter.y * chordLength
    verticalDistance([ORIGIN, lowerShoulderA.center]) == lowerBiarcs[3].firstCenter.y * chordLength
    verticalDistance([ORIGIN, lowerShoulderB.center]) == lowerBiarcs[3].secondCenter.y * chordLength
    verticalDistance([ORIGIN, lowerCrownA.center]) == lowerBiarcs[4].firstCenter.y * chordLength
    verticalDistance([ORIGIN, lowerCrownB.center]) == lowerBiarcs[4].secondCenter.y * chordLength
    verticalDistance([ORIGIN, lowerMidA.center]) == lowerBiarcs[5].firstCenter.y * chordLength
    verticalDistance([ORIGIN, lowerMidB.center]) == lowerBiarcs[5].secondCenter.y * chordLength
    verticalDistance([ORIGIN, lowerRearA.center]) == lowerBiarcs[6].firstCenter.y * chordLength
    verticalDistance([ORIGIN, lowerRearB.center]) == lowerBiarcs[6].secondCenter.y * chordLength
    verticalDistance([ORIGIN, lowerTailA.center]) == lowerBiarcs[7].firstCenter.y * chordLength
    verticalDistance([ORIGIN, lowerTailB.center]) == lowerBiarcs[7].secondCenter.y * chordLength
  }
  return airfoilSketch
}

/// Given a face index, find its ID.
/// In general, you should prefer tagging faces to using this function. Use this function if
/// you can't tag a face. For example, if the face comes from imported geometry in a .STEP file,
/// or if it's from an operation that doesn't yet support tagging the faces it creates, like `subtract`.
/// ```kcl,legacySketch
/// // Cylinder
/// cylinder = startSketchOn(XY)
///   |> circle(center = [0, 0], radius = 4.09, tag = $seg01)
///   |> extrude(length = 5)
///
/// // Delete the face at index 2
/// // (the top face)
/// deleteFace(cylinder, faces = [faceId(cylinder, index = 2)])
/// ```
@(impl = std_rust, feature_tree = false)
export fn faceId(
  /// The solid whose faces we're trying to find
  @body: Solid,
  /// Face to identify.
  /// The index is a stable ordering of faces, used when you can't get the
  /// usual ID of a face.
  index: number(Count),
): TaggedFace {}

/// Given an edge index, find its ID.
/// In general, you should prefer tagging edges to using this function. Use this function if
/// you can't tag an edge. For example, if the edge comes from imported geometry in a .STEP file,
/// or if it's from an operation that doesn't yet support tagging the edges it creates, like `subtract`.
/// ```kcl,legacySketch
/// // Cylinder
/// cylinder = startSketchOn(XY)
///   |> circle(center = [0, 0], radius = 4.09, tag = $seg01)
///   |> extrude(length = 5)
///   // Fillet the edge at index 2, i.e. the top edge.
///   |> fillet(radius = 1, tags = [edgeId(index = 2)])
/// ```
/// ```kcl,legacySketch
/// startSketchOn(XY)
///   |> rectangle(width = 10, height = 10, center = [0, 0])
///   |> extrude(length = 2)
///   |> fillet(radius = 0.5, tags = [edgeId(closestTo = [5, 0, 2])])
/// ```
@(impl = std_rust, feature_tree = false)
export fn edgeId(
  /// The solid whose edges we're trying to find
  @body: Solid,
  /// Edge to identify.
  /// The index is a stable ordering of edges, used when you can't get the
  /// usual ID of an edge.
  index?: number(Count),
  /// Query the edge closest to this point. Uses absolute global coordinates.
  closestTo?: Point3d,
): Edge {}
