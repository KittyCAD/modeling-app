---
source: kcl-lib/src/simulation_tests.rs
description: Result of unparsing cube_mm.kcl
---
fn cube(pos, scale) {
  sg = startSketchOn(XY)
    |> startProfile(at = pos)
    |> line(end = [0, scale])
    |> line(end = [scale, 0])
    |> line(end = [0, -scale])
    |> close()
    |> extrude(length = scale)

  return sg
}

myCube = cube(pos = [0, 0], scale = 10)
