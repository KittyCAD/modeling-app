@settings(kclVersion = 2.0)

sketch001 = sketch(on = YZ) {
  circle1 = circle(start = [var 38mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([circle1.center, ORIGIN])
  horizontal([circle1.start, ORIGIN])
  circle2 = circle(start = [var 90mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([circle2.center, circle1.center])
  horizontal([circle2.start, ORIGIN])
  diameter(circle1, labelPosition = [96.75mm, -51mm]) == 76
  diameter(circle2, labelPosition = [142.93mm, -13.29mm]) == 180
}
hidden001 = hide(sketch001)
region001 = region(point = [-89.9975mm, 0mm], sketch = sketch001)
extrude001 = extrude(region001, length = 200, symmetric = true)
sketch002 = sketch(on = YZ) {
  line1 = line(start = [var 0mm, var 0mm], end = [var -1825mm, var 0mm], construction = true)
  coincident([line1.start, ORIGIN])
  horizontal([line1.end, ORIGIN])
  line2 = line(start = [var -43.75mm, var 0mm], end = [var -43.75mm, var 75mm])
  horizontal([line2.start, ORIGIN])
  line3 = line(start = [var -43.75mm, var 75mm], end = [var -1625mm, var 75mm])
  coincident([line2.end, line3.start])
  line4 = line(start = [var -1625mm, var 75mm], end = [var -1625mm, var 87.13mm])
  coincident([line3.end, line4.start])
  line5 = line(start = [var -1625mm, var 87.13mm], end = [var -1825mm, var 87.13mm])
  coincident([line4.end, line5.start])
  line6 = line(start = [var -1825mm, var 87.13mm], end = [var -1825mm, var 51mm])
  coincident([line5.end, line6.start])
  line7 = line(start = [var -1825mm, var 51mm], end = [var -63.28mm, var 51mm])
  coincident([line6.end, line7.start])
  line8 = line(start = [var -63.28mm, var 51mm], end = [var -63.28mm, var 0mm])
  coincident([line8.start, line7.end])
  horizontal([line8.end, ORIGIN])
  parallel([line7, line5])
  parallel([line7, line3])
  parallel([line6, line4])
  parallel([line6, line8])
  parallel([line6, line2])
  perpendicular([line8, line7])
  distance([line5.start, line5.end], labelPosition = [-1741.46mm, 119.47mm]) == 200
  distance([line2.start, line2.end], labelPosition = [38.54mm, 34.35mm]) == 75
  distance([line8.start, line8.end], labelPosition = [10.01mm, 18.87mm]) == 51
  perpendicular([line1, line8])
  perpendicular([line2, line1])
  distance([line1.start, line1.end]) == 1825
  coincident([line6, line1.end])
  line9 = line(start = [var -63.28mm, var 0mm], end = [var -43.75mm, var 0mm])
  coincident([line9.start, line8.end])
  coincident([line9.end, line2.start])
}
hidden002 = hide(sketch002)
region002 = region(point = [-43.7525mm, 37.5mm], sketch = sketch002)
revolve001 = revolve(region002, angle = 360deg, axis = X)

export casing = union([extrude001, revolve001])
