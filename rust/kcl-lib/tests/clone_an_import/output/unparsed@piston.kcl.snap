---
source: kcl-lib/src/simulation_tests.rs
description: Result of unparsing tests/clone_an_import/piston.kcl
---
@settings(kclVersion = 2.0)

sketch001 = sketch(on = YZ) {
  circle1 = circle(start = [var 38mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([circle1.center, ORIGIN])
  horizontal([circle1.start, ORIGIN])
  circle2 = circle(start = [var 90mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([circle2.center, circle1.center])
  horizontal([circle2.start, ORIGIN])
  diameter(circle1, labelPosition = [97.4mm, -52.07mm]) == 76
  diameter(circle2, labelPosition = [84.6mm, -58.04mm]) == 180
}
hidden001 = hide(sketch001)
region001 = region(point = [-89.9975mm, 0mm], sketch = sketch001)
extrude001 = extrude(region001, length = 200, symmetric = true)

sketch002 = sketch(on = offsetPlane(XZ, offset = 50)) {
  circle1 = circle(start = [var 51mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([circle1.center, ORIGIN])
  horizontal([circle1.start, ORIGIN])
  diameter(circle1) == 102
}
hidden002 = hide(sketch002)
region002 = region(point = [-50.9975mm, 0mm], sketch = sketch002)
extrude002 = extrude(region002, length = 1750)

export pistonPole = union([extrude001, extrude002])
