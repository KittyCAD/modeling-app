sketch001 = sketch(on = XZ) {
  line1 = line(start = [var 0.94mm, var 3.48mm], end = [var 5.62mm, var 3.48mm])
  line2 = line(start = [var 6.56mm, var 2.54mm], end = [var 6.56mm, var 0mm])
  horizontal([line2.end, ORIGIN])
  line3 = line(start = [var 6.56mm, var 0mm], end = [var 0mm, var 0mm])
  coincident([line2.end, line3.start])
  coincident([line3.end, ORIGIN])
  line4 = line(start = [var 0mm, var 0mm], end = [var 0mm, var 2.54mm])
  coincident([line3.end, line4.start])
  vertical([line4.end, ORIGIN])
  arc1 = arc(start = [var 0.94mm, var 3.48mm], end = [var 0mm, var 2.54mm], center = [var 0.94mm, var 2.54mm])
  coincident([arc1.end, line4.end])
  coincident([arc1.start, line1.start])
  arc2 = arc(start = [var 5.62mm, var 3.48mm], end = [var 6.56mm, var 2.54mm], center = [var 5.62mm, var 2.54mm])
  coincident([arc2.end, line2.start])
  coincident([arc2.start, line1.end])
  tangent([line2, arc2])
  tangent([line1, arc2])
  tangent([line1, arc1])
  tangent([line4, arc1])
  perpendicular([line2, line3])
  perpendicular([line3, line4])
  equalLength([line2, line4])
  distance([line3.start, line3.end]) == 6.56mm
  perpendicular([line1, line4])
  distance([line3, line1]) == 3.48mm
  equalRadius([arc2, arc1])
  line5 = line(start = [var 3.28mm, var 3.48mm], end = [var 3.28mm, var 0mm], construction = true)
  coincident([line5.start, line1])
  midpoint(line1, point = line5.start)
  midpoint(line3, point = line5.end)
  perpendicular([line5, line3])
  perpendicular([line1, line5])
  distance([line4.start, line4.end]) == 2.54mm
  radius(arc1) == 0.94mm
  distance([line1.start, line1.end]) == 4.68mm
  arc3 = arc(start = [var 0.94mm, var 3.48mm], end = [var 0.94mm, var 5.36mm], center = [var 0.94mm, var 4.42mm])
  coincident([arc3.start, arc1.start])
  vertical([arc3.center, arc3.end])
  tangent([line1, arc3])
  equalRadius([arc3, arc1])
  line6 = line(start = [var 0.94mm, var 3.48mm], end = [var 0.94mm, var 5.36mm], construction = true)
  coincident([line6.start, arc3.start])
  coincident([line6.end, arc3.end])
  perpendicular([line6, line1])
  arc4 = arc(start = [var 0.94mm, var 3.48mm], end = [var 0.94mm, var 7.24mm], center = [var 0.94mm, var 5.36mm])
  coincident([arc4.center, line6.end])
  coincident([arc4.start, line6.start])
  line7 = line(start = [var 0.94mm, var 3.48mm], end = [var 0.94mm, var 7.24mm], construction = true)
  coincident([line7.start, arc4.start])
  coincident([line7.end, arc4.end])
  vertical([line7.end, arc4.center])
  tangent([line1, arc4])
}
