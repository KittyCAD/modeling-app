---
source: kcl-lib/src/simulation_tests.rs
description: Result of unparsing chamfer_version_removed_v3.kcl
---
// KCL 3.0 removed chamfer's version parameter; specifying it is an error.
@settings(kclVersion = "3.0-preview")

boxSketch = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  |> line(end = [10, 0], tag = $edge1)
  |> line(end = [0, 10])
  |> line(end = [-10, 0])
  |> close()

box = extrude(boxSketch, length = 5)
chamfered = chamfer(
  box,
  length = 1,
  tags = [getNextAdjacentEdge(edge1)],
  version = 2,
)
