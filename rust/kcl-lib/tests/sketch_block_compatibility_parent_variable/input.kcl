// In KCL 3 and earlier, the solver's line wins over the parent's non-callable
// `line` binding. The sketch can still read parentValue, and the call must leave
// the parent's bindings unchanged.

line = 123
parentValue = 5mm
profile = sketch(on = XY) {
  edge = line(start = [0mm, 0mm], end = [parentValue, 0mm])
}
parentAfter = line
assert(profile.edge.end.at[0], isEqualTo = parentValue)
