// Pins that a solid swept from a solved-sketch region along a solved-sketch
// path is engine-addressable by the id hide() sends. The rendered snapshot
// must show the anchor box and no tube. The profile circle and the path line
// remain visible as wireframe outlines: V2 sketches are scene objects of
// their own, and unlike the V1 sweep() pipeline (named_views_hide_sweep_v1),
// the V2 form does not hide its trajectory sketch.
@settings(kclVersion = 2.0)

sketch001 = sketch(on = XY) {
  circle1 = circle(start = [var 3, var 0], center = [var 0, var 0])
}
profile = region(point = [0, 0], sketch = sketch001)

sketch002 = sketch(on = XZ) {
  line1 = line(start = [var 0, var 0], end = [var 0, var 15])
}
path = [sketch002.line1]

tubeHidden = sweep(path, profile, version = 2)

anchorSketch = sketch(on = XY) {
  line1 = line(start = [var 20, var 0], end = [var 30, var 0])
  line2 = line(start = [var 30, var 0], end = [var 30, var 10])
  line3 = line(start = [var 30, var 10], end = [var 20, var 10])
  line4 = line(start = [var 20, var 10], end = [var 20, var 0])
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
}

boxVisible = extrude(region(point = [25, 5], sketch = anchorSketch), length = 10)

hide(tubeHidden)
