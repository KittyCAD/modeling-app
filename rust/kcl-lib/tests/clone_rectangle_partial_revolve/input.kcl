@settings(defaultLengthUnit = mm, kclVersion = 2.0)

profile = sketch(on = XZ) {
  bottom = line(start = [var 80mm, var -60mm], end = [var 120mm, var -60mm])
  right = line(start = [var 120mm, var -60mm], end = [var 120mm, var 60mm])
  top = line(start = [var 120mm, var 60mm], end = [var 80mm, var 60mm])
  left = line(start = [var 80mm, var 60mm], end = [var 80mm, var -60mm])
}

panelRegion = region(
  segments = [profile.bottom, profile.right, profile.top, profile.left],
  intersectionIndex = -1,
  direction = CCW,
)
panel = revolve(panelRegion, axis = Y, angle = 55deg)
  |> scale(x = 1.015, y = 0.79, z = 1, global = true)
panelCopy = clone(panel)
