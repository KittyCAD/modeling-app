          "name": "settings",
          "start": 0,
          "type": "Identifier"
        },
        "preComments": [
          "// Under KCL 3.0, fillets and chamfers are sent to the engine immediately, in",
          "// order with other modeling commands. The fillet consumes the edge tagged",
          "// seg01, so looking up that edge afterwards is an engine error. Under earlier",
          "// KCL versions, edge cuts were deferred until the end of the program and this",
          "// lookup succeeded. To do this under KCL 3.0, look up the opposite edge before",
          "// the fillet and store it in a variable."
        ],
        "properties": [
