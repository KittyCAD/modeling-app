square = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  |> line(end = [0, 10])
  |> line(end = [10, 0])
  |> line(end = [0, -10])
  |> close()
  |> subtract2d(tool = polygon(center = [2, 8], radius = .5), numSides = 3)
  |> subtract2d(tool = polygon(center = [2, 8], radius = .5))
  |> extrude(length = 2)
