@settings(experimentalFeatures = allow)

// With direction = CW, the arc sweeps clockwise from its declared start to its
// declared end. The same shape counterclockwise would need the start and end
// points swapped.
profile = sketch(on = XY) {
  base = line(start = [var -5mm, var 0mm], end = [var 5mm, var 0mm])
  top = arc(start = [var -5mm, var 0mm], end = [var 5mm, var 0mm], center = [var 0mm, var 5mm], direction = CW)
  coincident([base.start, top.start])
  coincident([base.end, top.end])
  fixed([base.start, [-5mm, 0mm]])
  fixed([base.end, [5mm, 0mm]])
  fixed([top.center, [0mm, 5mm]])
  // The midpoint of the clockwise sweep is at the top of the circle. If the
  // arc were counterclockwise, it would be at the bottom, below the base line.
  mid = point(at = [var 0mm, var 12mm])
  midpoint(top, point = mid)
}

// start and end still refer to the declared points.
assert(profile.top.start.at[0], isEqualTo = -5mm, tolerance = 0.0001mm)
assert(profile.top.start.at[1], isEqualTo = 0mm, tolerance = 0.0001mm)
assert(profile.top.end.at[0], isEqualTo = 5mm, tolerance = 0.0001mm)
assert(profile.top.end.at[1], isEqualTo = 0mm, tolerance = 0.0001mm)
// The midpoint of the clockwise sweep is directly above the center at
// [0, 5 + sqrt(50)].
assert(profile.mid.at[0], isEqualTo = 0mm, tolerance = 0.0001mm)
assert(profile.mid.at[1], isEqualTo = 12.071067811865476mm, tolerance = 0.0001mm)

solid = extrude(region(point = [0mm, 2mm], sketch = profile), length = 2)
