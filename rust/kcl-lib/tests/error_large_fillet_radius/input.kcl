// A 10 mm fillet cannot fit on a 5 mm cube.
@settings(defaultLengthUnit = mm)

part001 = startSketchOn(XY)
  |> startProfile(at = [0, 0])
  |> line(end = [5, 0], tag = $edge)
  |> line(end = [0, 5])
  |> line(end = [-5, 0])
  |> close()
  |> extrude(length = 5)
  |> fillet(radius = 10, tags = [edge])
