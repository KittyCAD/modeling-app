---
source: kcl-lib/src/simulation_tests.rs
description: Result of unparsing named_views_hide_extrude.kcl
---
// Pins that a solid extruded from a solved-sketch region is engine-addressable
// by the id hide() sends. The rendered snapshot must show exactly ONE box. The hidden box's
// source sketch remains visible as a wireframe outline: a V2 sketch is a
// scene object of its own, and hiding the solid does not hide it.
sketchVisible = sketch(on = XY) {
  line1 = line(start = [var 20, var 0], end = [var 30, var 0])
  line2 = line(start = [var 30, var 0], end = [var 30, var 10])
  line3 = line(start = [var 30, var 10], end = [var 20, var 10])
  line4 = line(start = [var 20, var 10], end = [var 20, var 0])
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
}

boxVisible = extrude(region(point = [25, 5], sketch = sketchVisible), length = 10)

sketchHidden = sketch(on = XY) {
  line1 = line(start = [var 0, var 0], end = [var 10, var 0])
  line2 = line(start = [var 10, var 0], end = [var 10, var 10])
  line3 = line(start = [var 10, var 10], end = [var 0, var 10])
  line4 = line(start = [var 0, var 10], end = [var 0, var 0])
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
}

boxHidden = extrude(region(point = [5, 5], sketch = sketchHidden), length = 10)

hide(boxHidden)
