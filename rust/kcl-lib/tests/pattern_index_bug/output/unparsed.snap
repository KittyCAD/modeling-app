---
source: kcl-lib/src/simulation_tests.rs
description: Result of unparsing pattern_index_bug.kcl
---
@settings(defaultLengthUnit = mm, kclVersion = 3.0, experimentalFeatures = allow)

sketch001 = sketch(on = XY) {
  line1 = line(start = [var -8.43mm, var 4.06mm], end = [var -2.12mm, var 4.06mm])
  line2 = line(start = [var -2.12mm, var 4.06mm], end = [var -2.12mm, var -4.02mm])
  line3 = line(start = [var -2.12mm, var -4.02mm], end = [var -8.43mm, var -4.02mm])
  line4 = line(start = [var -8.43mm, var -4.02mm], end = [var -8.43mm, var 4.06mm])
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
  parallel([line2, line4])
  parallel([line3, line1])
  perpendicular([line1, line2])
  horizontal(line3)
}
hidden001 = hide(sketch001)
square = region(segments = [sketch001.line1, sketch001.line2], direction = CW)
cube = extrude(square, length = 4, tagEnd = $capEnd001)

cubes = patternLinear3d(
  cube,
  instances = 3,
  distance = 14,
  axis = X,
)

appearance(
  cubes[0],
  color = "#da4333",
  metalness = 90,
  roughness = 50,
)
appearance(
  cubes[1],
  color = "#34daa8",
  metalness = 90,
  roughness = 50,
)
appearance(
  cubes[2],
  color = "#6134da",
  metalness = 90,
  roughness = 50,
)

// Fillet a different edge of each cube.
fillet(
  cubes[0],
  edges = [
    {
      sideFaces = [
        square.tags.line4,
        cubes[0].faces.capEnd001
      ]
    }
  ],
  radius = 1,
)

fillet(
  cubes[1],
  edges = [
    {
      sideFaces = [
        square.tags.line3,
        cubes[1].faces.capEnd001
      ]
    }
  ],
  radius = 1,
)

fillet(
  cubes[2],
  edges = [
    {
      sideFaces = [
        square.tags.line2,
        cubes[2].faces.capEnd001
      ]
    }
  ],
  radius = 1,
)
