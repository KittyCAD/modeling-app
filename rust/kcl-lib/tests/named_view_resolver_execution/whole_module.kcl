@settings(kclVersion = "3.0", defaultLengthUnit = mm)

import "panel.kcl" as panel

importedPlane = panel

localPlane = offsetPlane(XY, offset = 20)
hide(localPlane)

localFront = view::named(
  "Front",
  camera = view::oriented(view::Orientation::Back),
  baseline = view::Visibility::Hide,
  except = [localPlane],
)
