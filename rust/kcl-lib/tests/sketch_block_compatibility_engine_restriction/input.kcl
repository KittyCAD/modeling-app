// The extrude call must fail inside a sketch block because it sends engine
// commands. Solver segment constructors remain valid there.

square = sketch(on = XY) {
  line1 = line(start = [var 0mm, var 0mm], end = [var 1mm, var 0mm])
  line2 = line(start = [var 1mm, var 0mm], end = [var 1mm, var 1mm])
  line3 = line(start = [var 1mm, var 1mm], end = [var 0mm, var 1mm])
  line4 = line(start = [var 0mm, var 1mm], end = [var 0mm, var 0mm])
  coincident([line1.start, ORIGIN])
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
  equalLength([line1, line2, line3, line4])
  parallel([line1, line3])
  parallel([line2, line4])
  horizontal(line1)
}

region1 = region(segments = [square.line1, square.line2])

sketch(on = XY) {
  extrude(region1, length = 2mm)
}
