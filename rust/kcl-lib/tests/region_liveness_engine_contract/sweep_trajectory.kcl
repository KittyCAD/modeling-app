@settings(defaultLengthUnit = mm, kclVersion = 2.0)

trajectorySketch = sketch(on = XY) {
  c = circle(start = [var 20mm, var 0mm], center = [var 0mm, var 0mm])
}
sharedTrajectory = region(segments = [trajectorySketch.c])

firstProfileSketch = sketch(on = XZ) {
  c = circle(start = [var 22mm, var 0mm], center = [var 20mm, var 0mm])
}
secondProfileSketch = sketch(on = XZ) {
  c = circle(start = [var 22mm, var 0mm], center = [var 20mm, var 0mm])
}
firstProfile = region(segments = [firstProfileSketch.c])
secondProfile = region(segments = [secondProfileSketch.c])

first = sweep(firstProfile, path = sharedTrajectory, version = 2)
second = sweep(secondProfile, path = sharedTrajectory, version = 2)
