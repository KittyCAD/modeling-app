@settings(defaultLengthUnit = mm, kclVersion = 2.0)

profileSketch = sketch(on = XY) {
  c = circle(start = [var 25mm, var 0mm], center = [var 20mm, var 0mm])
}
sharedRegion = region(segments = [profileSketch.c])

// The harness resends this raw command to model the second profile in
// revolve([sharedRegion, sharedRegion], ...) below KCL's liveness check.
revolve(sharedRegion, axis = Y, angle = 180deg)
