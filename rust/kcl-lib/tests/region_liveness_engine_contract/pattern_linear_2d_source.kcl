@settings(defaultLengthUnit = mm, kclVersion = 2.0)

profileSketch = sketch(on = XY) {
  c = circle(start = [var 5mm, var 0mm], center = [var 0mm, var 0mm])
}
sharedRegion = region(segments = [profileSketch.c])

first = patternLinear2d(sharedRegion, instances = 2, distance = 20mm, axis = X)
second = patternLinear2d(sharedRegion, instances = 2, distance = 30mm, axis = X)
