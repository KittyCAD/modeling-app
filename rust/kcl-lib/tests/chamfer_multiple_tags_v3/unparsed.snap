---
source: kcl-lib/src/simulation_tests.rs
description: Result of unparsing chamfer_multiple_tags_v3.kcl
---
// Under KCL 3.0, chamfering multiple edges cuts them all at once in a
// single engine command, without needing to opt in via a version argument.
@settings(defaultLengthUnit = mm, kclVersion = "3.0-preview")

plateProfile = sketch(on = XY) {
  bottom = line(start = [var -10mm, var -10mm], end = [var 10mm, var -10mm])
  right = line(start = [var 10mm, var -10mm], end = [var 10mm, var 10mm])
  top = line(start = [var 10mm, var 10mm], end = [var -10mm, var 10mm])
  left = line(start = [var -10mm, var 10mm], end = [var -10mm, var -10mm])
}

plateRegion = region(point = [0mm, 0mm], sketch = plateProfile)
plate = extrude(plateRegion, length = 4mm)

// Chamfer all four vertical edges, each identified by the two side faces
// that share it.
chamfered = chamfer(
  plate,
  length = 2mm,
  tags = [
    getCommonEdge(faces = [
      plateRegion.tags.bottom,
      plateRegion.tags.right
    ]),
    getCommonEdge(faces = [
      plateRegion.tags.right,
      plateRegion.tags.top
    ]),
    getCommonEdge(faces = [
      plateRegion.tags.top,
      plateRegion.tags.left
    ]),
    getCommonEdge(faces = [
      plateRegion.tags.left,
      plateRegion.tags.bottom
    ])
  ],
)
