// In KCL 3, returning from the sketch must exit the enclosing if and function.
// KCL 1/2 finish the branch with 9. Later expressions and sketches must run
// in every version.

fn fromBranch() {
  branch = if true {
    profile = sketch(on = XY) {
      local = 17
      edge = line(start = [var 0mm, var 0mm], end = [var 10mm, var 0mm])
      return 42
    }
    9
  } else {
    8
  }
  return branch
}

result = fromBranch()
secondCall = fromBranch()
outside = 6 == 6
after = sketch(on = YZ) {
  marker = 7
  edge = line(start = [0mm, 0mm], end = [10mm, 0mm])
}
planeAfter = offsetPlane(XY, offset = 2mm)
