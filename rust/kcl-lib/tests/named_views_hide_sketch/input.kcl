// Pins that a solved sketch is engine-addressable by the id hide() sends.
// The rendered snapshot must show exactly ONE circle: the one centered at
// x = 20.
sketchVisible = sketch(on = XY) {
  circle1 = circle(start = [var 23, var 0], center = [var 20, var 0])
}

sketchHidden = sketch(on = XY) {
  circle1 = circle(start = [var 3, var 0], center = [var 0, var 0])
}

hide(sketchHidden)
