// PROPELLANT LINE BRACKET + P-CLAMP -- Zoo's two formed metal components.
// Source: KittyCAD/kcl-llm-finetuning/data/kcl-samples/propellant-line-brackets/main.kcl
// Concentric bend radii now maintain the stated sheet thickness throughout each bend.
@settings(defaultLengthUnit = in, kclVersion = 3.0, experimentalFeatures = allow)

bracketWidth = 2in
bracketLength = 4in
bracketFlangeHeight = 1.5in
bracketThickness = 0.25in
insideBendRadius = 0.125in
outsideBendRadius = insideBendRadius + bracketThickness
holeDiameter = 0.5in
tubeDiameter = 1.5in
clampWidth = 1in
clampThickness = 0.125in
clampOuterRadius = tubeDiameter / 2 + clampThickness

fn advance(@at, heading, distance) {
  return [at[0] + distance * cos(heading), at[1] + distance * sin(heading)]
}
fn bend(@at, heading, radius, turn) {
  sign = if turn > 0deg { 1 } else { -1 }
  center = [at[0] - sign * radius * sin(heading), at[1] + sign * radius * cos(heading)]
  return {
    center = center,
    end = [center[0] + sign * radius * sin(heading + turn), center[1] - sign * radius * cos(heading + turn)]
  }
}

// Cutting tools are separate solids; their construction sketches are hidden immediately.
fn drill(@plane, at, radius, depth) {
  boreRadius = radius
  profile = sketch(on = plane) {
    bore = circle(start = [at[0] + boreRadius, at[1]], center = at)
  }
  tool = extrude(region(segments = [profile.bore]), length = depth)
  hide(profile)
  return tool
}
fn cornerCut(@plane, at, xSign, ySign, radius, depth) {
  a = [at[0] - xSign * radius, at[1]]
  c = [at[0], at[1] - ySign * radius]
  center = [at[0] - xSign * radius, at[1] - ySign * radius]
  profile = sketch(on = plane) {
    outerA = line(start = a, end = at)
    outerB = line(start = at, end = c)
    round = arc(start = c, end = a, center = center, direction = if xSign * ySign > 0 { CCW } else { CW })
  }
  tool = extrude(region(segments = [profile.outerA, profile.outerB, profile.round]), length = depth)
  hide(profile)
  return tool
}

section = sketch(on = YZ) {
  base = line(start = [bracketWidth, 0in], end = [outsideBendRadius, 0in])
  heel = arc(start = [outsideBendRadius, 0in], end = [0in, outsideBendRadius], center = [outsideBendRadius, outsideBendRadius], direction = CW)
  wall = line(start = [0in, outsideBendRadius], end = [0in, bracketFlangeHeight])
}
bracketSurface = extrude([section.base, section.heel, section.wall], length = bracketLength, bodyType = SURFACE)
hide(section)
bracketBlank = thicken(bracketSurface, thickness = bracketThickness, flip = false)
basePlane = offsetPlane(XY, offset = -bracketThickness)
wallPlane = offsetPlane(XZ, offset = -2 * bracketThickness)
baseA = drill(basePlane, at = [bracketLength - 0.5in, 1in], radius = holeDiameter / 2, depth = 3 * bracketThickness)
baseB = drill(basePlane, at = [bracketLength / 2, 1.5in], radius = holeDiameter / 2, depth = 3 * bracketThickness)
baseC = drill(basePlane, at = [0.5in, 1in], radius = holeDiameter / 2, depth = 3 * bracketThickness)
wallA = drill(wallPlane, at = [0.5in, 1in], radius = holeDiameter / 2, depth = 3 * bracketThickness)
wallB = drill(wallPlane, at = [bracketLength - 0.5in, 1in], radius = holeDiameter / 2, depth = 3 * bracketThickness)
cornerRadius = 0.125in
roundA = cornerCut(basePlane, at = [0in, bracketWidth], xSign = -1, ySign = 1, radius = cornerRadius, depth = 3 * bracketThickness)
roundB = cornerCut(basePlane, at = [bracketLength, bracketWidth], xSign = 1, ySign = 1, radius = cornerRadius, depth = 3 * bracketThickness)
roundC = cornerCut(wallPlane, at = [0in, bracketFlangeHeight], xSign = -1, ySign = 1, radius = cornerRadius, depth = 3 * bracketThickness)
roundD = cornerCut(wallPlane, at = [bracketLength, bracketFlangeHeight], xSign = 1, ySign = 1, radius = cornerRadius, depth = 3 * bracketThickness)
bracket = subtract(bracketBlank, tools = [baseA, baseB, baseC, wallA, wallB, roundA, roundB, roundC, roundD])
  |> appearance(color = "#a18e30", metalness = 65, roughness = 35)

// Preserve the original 300-degree open loop and the two mounting ears.
clampStart = [0in, 0in]
clampArcStart = [-2in, 0in]
clampTurn = bend(clampArcStart, heading = 180deg, radius = clampOuterRadius, turn = -300deg)
clampEnd = [0in, clampTurn.end[1]]
clampSection = sketch(on = -XZ) {
  lowerEar = line(start = clampStart, end = clampArcStart)
  wrapArc = arc(start = clampArcStart, end = clampTurn.end, center = clampTurn.center, direction = CW)
  upperEar = line(start = clampTurn.end, end = clampEnd)
}
clampSurface = extrude([clampSection.lowerEar, clampSection.wrapArc, clampSection.upperEar], length = clampWidth, bodyType = SURFACE)
hide(clampSection)
clampBlank = thicken(clampSurface, thickness = clampThickness, flip = false)
clampHole = drill(offsetPlane(XY, offset = -clampThickness), at = [clampWidth / 2, clampWidth / 2], radius = holeDiameter / 2, depth = 2 * clampOuterRadius)
chamferFront = sketch(on = offsetPlane(XY, offset = -clampThickness)) {
  a = line(start = [0in, 0in], end = [clampThickness, 0in])
  b = line(start = [clampThickness, 0in], end = [0in, clampThickness])
  c = line(start = [0in, clampThickness], end = [0in, 0in])
}
chamferFrontTool = extrude(region(segments = [chamferFront.a, chamferFront.b, chamferFront.c]), length = 2 * clampOuterRadius)
hide(chamferFront)
chamferBack = sketch(on = offsetPlane(XY, offset = -clampThickness)) {
  a = line(start = [0in, clampWidth], end = [0in, clampWidth - clampThickness])
  b = line(start = [0in, clampWidth - clampThickness], end = [clampThickness, clampWidth])
  c = line(start = [clampThickness, clampWidth], end = [0in, clampWidth])
}
chamferBackTool = extrude(region(segments = [chamferBack.a, chamferBack.b, chamferBack.c]), length = 2 * clampOuterRadius)
hide(chamferBack)
clamp = subtract(clampBlank, tools = [clampHole, chamferFrontTool, chamferBackTool])
  |> appearance(color = "#4191c3", metalness = 65, roughness = 32)
  |> rotate(yaw = 90deg)
  |> translate(x = bracketLength / 2 + clampWidth / 2, y = bracketWidth / 2, z = bracketThickness, global = true)
