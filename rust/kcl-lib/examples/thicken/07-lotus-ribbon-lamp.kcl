// A lantern made from 20 bowed metal ribbons around an amber diffuser.
// Every ribbon starts as one continuous line/arc surface, then gains volume.
@settings(defaultLengthUnit = mm, kclVersion = 3.0, experimentalFeatures = allow)

petalCount = 20
ribbonWidth = 9mm
wallThickness = 1.2mm

petal = sketch(on = offsetPlane(XZ, offset = -ribbonWidth / 2)) {
  foot = line(start = [var 30mm, var 0mm], end = [var 30mm, var 5mm])
  lowerBend = arc(start = [var 30mm, var 5mm], end = [var 46mm, var 21mm], center = [var 30mm, var 21mm])
  spine = line(start = [var 46mm, var 21mm], end = [var 46mm, var 64mm])
  shoulder = arc(start = [var 46mm, var 64mm], end = [var 30mm, var 80mm], center = [var 30mm, var 64mm])
  crown = line(start = [var 30mm, var 80mm], end = [var 18mm, var 80mm])
}
petalSurface = extrude([petal.foot, petal.lowerBend, petal.spine, petal.shoulder, petal.crown], length = ribbonWidth, bodyType = SURFACE)
petalBody = thicken(petalSurface, thickness = wallThickness, center = true)
  |> appearance(color = "#cb9650", metalness = 90, roughness = 24)
petals = patternCircular3d(petalBody, instances = petalCount, axis = Z, rotateDuplicates = true)

baseProfile = sketch(on = offsetPlane(XY, offset = -6mm)) {
  pedestal = circle(start = [var 37mm, var 0mm], center = [var 0mm, var 0mm])
}
base = extrude(region(segments = [baseProfile.pedestal]), length = 6mm)
  |> appearance(color = "#182832", metalness = 70, roughness = 32)

collarProfile = sketch(on = XY) {
  collar = circle(start = [var 29mm, var 0mm], center = [var 0mm, var 0mm])
}
collarSurface = extrude(collarProfile.collar, length = 5mm, bodyType = SURFACE)
collarBody = thicken(collarSurface, thickness = 3mm, flip = false)
  |> appearance(color = "#182832", metalness = 75, roughness = 28)

diffuserProfile = sketch(on = offsetPlane(XY, offset = 5mm)) {
  core = circle(start = [var 12mm, var 0mm], center = [var 0mm, var 0mm])
}
diffuserSurface = extrude(diffuserProfile.core, length = 70mm, bodyType = SURFACE)
diffuser = thicken(diffuserSurface, thickness = 1mm, flip = true)
  |> appearance(color = "#ffce75", metalness = 0, roughness = 65, opacity = 65)

crownProfile = sketch(on = offsetPlane(XY, offset = 78mm)) {
  ring = circle(start = [var 19mm, var 0mm], center = [var 0mm, var 0mm])
}
crownSurface = extrude(crownProfile.ring, length = 4mm, bodyType = SURFACE)
crownRing = thicken(crownSurface, thickness = 3mm, center = true)
  |> appearance(color = "#182832", metalness = 75, roughness = 28)

// Keep construction sketches out of the final rendering.
hide(petal)
hide(baseProfile)
hide(collarProfile)
hide(diffuserProfile)
hide(crownProfile)
