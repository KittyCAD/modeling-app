// ADJUSTABLE L-BRACKET -- Zoo's slotted, countersunk sheet-metal example.
// Source: KittyCAD/kcl-llm-finetuning/data/kcl-samples/bracket-with-slot/main.kcl
@settings(defaultLengthUnit = mm, kclVersion = 3.0, experimentalFeatures = allow)

halfBracketWidth = 20mm
fastenerHoleDiameter = 12mm
countersinkOuterDiameter = 22mm
uprightTabHoleCenterOffsetFromBend = 50mm
slotCenterOffsetFromBend = 150mm
sheetMetalThickness = 4mm
insideBendRadius = 8mm
outsideBendRadius = insideBendRadius + sheetMetalThickness
overallBracketWidth = 2 * halfBracketWidth
uprightEnd = uprightTabHoleCenterOffsetFromBend + halfBracketWidth
baseEnd = slotCenterOffsetFromBend + halfBracketWidth

// Cutting tools are separate solids; their construction sketches are hidden immediately.
fn drill(@plane, at, radius, depth) {
  boreRadius = radius
  profile = sketch(on = plane) {
    bore = circle(start = [at[0] + boreRadius, at[1]], center = at)
  }
  tool = extrude(region(segments = [profile.bore]), length = depth)
  hide(profile)
  return tool
}
fn cornerCut(@plane, at, xSign, ySign, radius, depth) {
  a = [at[0] - xSign * radius, at[1]]
  c = [at[0], at[1] - ySign * radius]
  center = [at[0] - xSign * radius, at[1] - ySign * radius]
  profile = sketch(on = plane) {
    outerA = line(start = a, end = at)
    outerB = line(start = at, end = c)
    round = arc(start = c, end = a, center = center, direction = if xSign * ySign > 0 { CCW } else { CW })
  }
  tool = extrude(region(segments = [profile.outerA, profile.outerB, profile.round]), length = depth)
  hide(profile)
  return tool
}

section = sketch(on = XZ) {
  upright = line(start = [0mm, uprightEnd], end = [0mm, outsideBendRadius])
  bend = arc(start = [0mm, outsideBendRadius], end = [outsideBendRadius, 0mm], center = [outsideBendRadius, outsideBendRadius])
  base = line(start = [outsideBendRadius, 0mm], end = [baseEnd, 0mm])
}
surface = extrude([section.upright, section.bend, section.base], length = overallBracketWidth, symmetric = true, bodyType = SURFACE)
hide(section)
formedBlank = thicken(surface, thickness = sheetMetalThickness, flip = true)
footPlane = offsetPlane(XY, offset = -sheetMetalThickness)
wallPlane = offsetPlane(YZ, offset = -sheetMetalThickness)
footRoundA = cornerCut(footPlane, at = [baseEnd, halfBracketWidth], xSign = 1, ySign = 1, radius = halfBracketWidth, depth = 3 * sheetMetalThickness)
footRoundB = cornerCut(footPlane, at = [baseEnd, -halfBracketWidth], xSign = 1, ySign = -1, radius = halfBracketWidth, depth = 3 * sheetMetalThickness)
wallRoundA = cornerCut(wallPlane, at = [halfBracketWidth, uprightEnd], xSign = 1, ySign = 1, radius = halfBracketWidth, depth = 3 * sheetMetalThickness)
wallRoundB = cornerCut(wallPlane, at = [-halfBracketWidth, uprightEnd], xSign = -1, ySign = 1, radius = halfBracketWidth, depth = 3 * sheetMetalThickness)

// Original slot: 36 mm between semicircle centers, plus 6 mm end radii.
slotRadius = fastenerHoleDiameter / 2
slotA = slotCenterOffsetFromBend - 3 * fastenerHoleDiameter
slotB = slotCenterOffsetFromBend
slotSketch = sketch(on = footPlane) {
  bottom = line(start = [slotA, -slotRadius], end = [slotB, -slotRadius])
  right = arc(start = [slotB, -slotRadius], end = [slotB, slotRadius], center = [slotB, 0mm])
  top = line(start = [slotB, slotRadius], end = [slotA, slotRadius])
  left = arc(start = [slotA, slotRadius], end = [slotA, -slotRadius], center = [slotA, 0mm])
}
slotTool = extrude(region(segments = [slotSketch.bottom, slotSketch.right, slotSketch.top, slotSketch.left]), length = 3 * sheetMetalThickness)
hide(slotSketch)

// 90-degree countersink. Extend its conical tool beyond both wall faces.
sinkDepth = (countersinkOuterDiameter - fastenerHoleDiameter) / 2
sinkSmallX = sheetMetalThickness - sinkDepth - 1mm
sinkLargeX = sheetMetalThickness + 1mm
sinkSmallRadius = fastenerHoleDiameter / 2 - 1mm
sinkLargeRadius = countersinkOuterDiameter / 2 + 1mm
sinkSmall = sketch(on = offsetPlane(YZ, offset = sinkSmallX)) {
  rim = circle(start = [sinkSmallRadius, uprightTabHoleCenterOffsetFromBend], center = [0mm, uprightTabHoleCenterOffsetFromBend])
}
sinkLarge = sketch(on = offsetPlane(YZ, offset = sinkLargeX)) {
  rim = circle(start = [sinkLargeRadius, uprightTabHoleCenterOffsetFromBend], center = [0mm, uprightTabHoleCenterOffsetFromBend])
}
sinkTool = loft([region(segments = [sinkSmall.rim]), region(segments = [sinkLarge.rim])])
hide(sinkSmall)
hide(sinkLarge)
pilotTool = drill(wallPlane, at = [0mm, uprightTabHoleCenterOffsetFromBend], radius = fastenerHoleDiameter / 2, depth = 3 * sheetMetalThickness)
finishedBracket = subtract(formedBlank, tools = [footRoundA, footRoundB, wallRoundA, wallRoundB, slotTool, sinkTool, pilotTool])
  |> appearance(color = "#c8ff00", roughness = 50, metalness = 0)
