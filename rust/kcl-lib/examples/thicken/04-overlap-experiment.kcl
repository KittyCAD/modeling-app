// Deliberate overlap: a 3 mm gap with a 2 mm wall growing toward it.
// Both legs grow into the gap, so the offset overlaps itself.
// Change gap or wallThickness to explore the result.
@settings(defaultLengthUnit = mm, kclVersion = 3.0, experimentalFeatures = allow)

gap = 3mm
wallThickness = 2mm

profile = sketch(on = XY) {
  lower = line(start = [var 0mm, var 0mm], end = [var 40mm, var 0mm])
  bend = line(start = [var 40mm, var 0mm], end = [var 40mm, gap])
  upper = line(start = [var 40mm, gap], end = [var 0mm, gap])
}

surface = extrude([profile.lower, profile.bend, profile.upper], length = 16mm, bodyType = SURFACE)
overlap = thicken(surface, thickness = wallThickness, side = "opposite")
appearance(overlap, color = "#dd5577", opacity = 65, roughness = 35)
