// Five tangent half-circle bays form a continuous, thin copper wave roof.
// Centered thickening keeps the architectural section on its design surface.
@settings(defaultLengthUnit = mm, kclVersion = 3.0, experimentalFeatures = allow)

roofDepth = 110mm
roofThickness = 1.5mm

roofSection = sketch(on = offsetPlane(XZ, offset = -roofDepth / 2)) {
  crest1 = arc(start = [var -90mm, var 60mm], end = [var -60mm, var 60mm], center = [var -75mm, var 60mm], direction = CW)
  valley1 = arc(start = [var -60mm, var 60mm], end = [var -30mm, var 60mm], center = [var -45mm, var 60mm])
  crest2 = arc(start = [var -30mm, var 60mm], end = [var 0mm, var 60mm], center = [var -15mm, var 60mm], direction = CW)
  valley2 = arc(start = [var 0mm, var 60mm], end = [var 30mm, var 60mm], center = [var 15mm, var 60mm])
  crest3 = arc(start = [var 30mm, var 60mm], end = [var 60mm, var 60mm], center = [var 45mm, var 60mm], direction = CW)
}
roofSurface = extrude([roofSection.crest1, roofSection.valley1, roofSection.crest2, roofSection.valley2, roofSection.crest3], length = roofDepth, bodyType = SURFACE)
roof = thicken(roofSurface, thickness = roofThickness, center = true)
  |> appearance(color = "#bc754b", metalness = 85, roughness = 30)

deckProfile = sketch(on = offsetPlane(XY, offset = -4mm)) {
  front = line(start = [var -100mm, var -65mm], end = [var 70mm, var -65mm])
  right = line(start = [var 70mm, var -65mm], end = [var 70mm, var 65mm])
  back = line(start = [var 70mm, var 65mm], end = [var -100mm, var 65mm])
  left = line(start = [var -100mm, var 65mm], end = [var -100mm, var -65mm])
}
deck = extrude(region(segments = [deckProfile.front, deckProfile.right, deckProfile.back, deckProfile.left]), length = 4mm)
  |> appearance(color = "#26343a", metalness = 15, roughness = 80)

columns = sketch(on = XY) {
  a = circle(start = [var -72.5mm, var -46mm], center = [var -75mm, var -46mm])
  b = circle(start = [var -12.5mm, var -46mm], center = [var -15mm, var -46mm])
  c = circle(start = [var 47.5mm, var -46mm], center = [var 45mm, var -46mm])
  d = circle(start = [var -72.5mm, var 46mm], center = [var -75mm, var 46mm])
  e = circle(start = [var -12.5mm, var 46mm], center = [var -15mm, var 46mm])
  f = circle(start = [var 47.5mm, var 46mm], center = [var 45mm, var 46mm])
}
columnA = extrude(region(segments = [columns.a]), length = 74mm)
columnB = extrude(region(segments = [columns.b]), length = 74mm)
columnC = extrude(region(segments = [columns.c]), length = 74mm)
columnD = extrude(region(segments = [columns.d]), length = 74mm)
columnE = extrude(region(segments = [columns.e]), length = 74mm)
columnF = extrude(region(segments = [columns.f]), length = 74mm)
appearance([columnA, columnB, columnC, columnD, columnE, columnF], color = "#e2d5bb", metalness = 35, roughness = 38)
