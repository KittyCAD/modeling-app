// RETURN-FLANGED BEARING CLEVIS -- one 3 mm formed sheet, four 8 mm bends.
// LEFT: cyan surface with NO volume. RIGHT: thickened, bored clevis bracket.
// Two coaxial bearing openings, four base holes, and four return-flange holes.
@settings(defaultLengthUnit = mm, kclVersion = 3.0, experimentalFeatures = allow)

sheetThickness = 3mm
bracketWidth = 76mm

section = sketch(on = offsetPlane(XZ, offset = -bracketWidth / 2)) {
  leftReturn = line(start = [var -56mm, var 65mm], end = [var -46mm, var 65mm])
  leftCrown = arc(start = [var -46mm, var 65mm], end = [var -38mm, var 57mm], center = [var -46mm, var 57mm], direction = CW)
  leftCheek = line(start = [var -38mm, var 57mm], end = [var -38mm, var 8mm])
  leftHeel = arc(start = [var -38mm, var 8mm], end = [var -30mm, var 0mm], center = [var -30mm, var 8mm])
  saddle = line(start = [var -30mm, var 0mm], end = [var 30mm, var 0mm])
  rightHeel = arc(start = [var 30mm, var 0mm], end = [var 38mm, var 8mm], center = [var 30mm, var 8mm])
  rightCheek = line(start = [var 38mm, var 8mm], end = [var 38mm, var 57mm])
  rightCrown = arc(start = [var 38mm, var 57mm], end = [var 46mm, var 65mm], center = [var 46mm, var 57mm], direction = CW)
  rightReturn = line(start = [var 46mm, var 65mm], end = [var 56mm, var 65mm])
}
sheetSurface = extrude([section.leftReturn, section.leftCrown, section.leftCheek, section.leftHeel, section.saddle, section.rightHeel, section.rightCheek, section.rightCrown, section.rightReturn], length = bracketWidth, bodyType = SURFACE)
referenceSurface = clone(sheetSurface)
  |> translate(x = -155mm)
  |> appearance(color = "#39cddd", backfaceColor = "#22788c", opacity = 55)

// The entire U channel and both return flanges gain volume here.
formedBlank = thicken(sheetSurface, thickness = sheetThickness, flip = false)

baseHoles = sketch(on = offsetPlane(XY, offset = -6mm)) {
  baseA = circle(start = [var -14.7mm, var -25mm], center = [var -18mm, var -25mm])
  baseB = circle(start = [var 21.3mm, var -25mm], center = [var 18mm, var -25mm])
  baseC = circle(start = [var 21.3mm, var 25mm], center = [var 18mm, var 25mm])
  baseD = circle(start = [var -14.7mm, var 25mm], center = [var -18mm, var 25mm])
}
baseATool = extrude(region(segments = [baseHoles.baseA]), length = 12mm)
baseBTool = extrude(region(segments = [baseHoles.baseB]), length = 12mm)
baseCTool = extrude(region(segments = [baseHoles.baseC]), length = 12mm)
baseDTool = extrude(region(segments = [baseHoles.baseD]), length = 12mm)
flangeHoles = sketch(on = offsetPlane(XY, offset = 59mm)) {
  flangeA = circle(start = [var -48.4mm, var -25mm], center = [var -51mm, var -25mm])
  flangeB = circle(start = [var -48.4mm, var 25mm], center = [var -51mm, var 25mm])
  flangeC = circle(start = [var 53.6mm, var -25mm], center = [var 51mm, var -25mm])
  flangeD = circle(start = [var 53.6mm, var 25mm], center = [var 51mm, var 25mm])
}
flangeATool = extrude(region(segments = [flangeHoles.flangeA]), length = 12mm)
flangeBTool = extrude(region(segments = [flangeHoles.flangeB]), length = 12mm)
flangeCTool = extrude(region(segments = [flangeHoles.flangeC]), length = 12mm)
flangeDTool = extrude(region(segments = [flangeHoles.flangeD]), length = 12mm)
// One long boring tool produces exactly coaxial openings in both cheeks.
crossHoles = sketch(on = offsetPlane(YZ, offset = -45mm)) {
  bearing = circle(start = [var 14mm, var 37mm], center = [var 0mm, var 37mm])
  reliefA = circle(start = [var -21mm, var 17mm], center = [var -25mm, var 17mm])
  reliefB = circle(start = [var 29mm, var 17mm], center = [var 25mm, var 17mm])
}
bearingTool = extrude(region(segments = [crossHoles.bearing]), length = 90mm)
reliefATool = extrude(region(segments = [crossHoles.reliefA]), length = 90mm)
reliefBTool = extrude(region(segments = [crossHoles.reliefB]), length = 90mm)
finishedBracket = subtract(formedBlank, tools = [baseATool, baseBTool, baseCTool, baseDTool, flangeATool, flangeBTool, flangeCTool, flangeDTool, bearingTool, reliefATool, reliefBTool])
  |> appearance(color = "#c49554", metalness = 85, roughness = 32)

// Keep construction sketches out of the final rendering.
hide(section)
hide(baseHoles)
hide(flangeHoles)
hide(crossHoles)
