// A cutaway-style turbine: 18 curved, solid vanes inside a translucent shroud.
// Change bladeCount, bladeHeight, or wallThickness to explore the assembly.
@settings(defaultLengthUnit = mm, kclVersion = 3.0, experimentalFeatures = allow)

bladeCount = 18
bladeHeight = 30mm
wallThickness = 1.6mm

vane = sketch(on = offsetPlane(XY, offset = 4mm)) {
  root = line(start = [var 18mm, var 0mm], end = [var 24mm, var 0mm])
  sweep = arc(start = [var 24mm, var 0mm], end = [var 60mm, var 36mm], center = [var 24mm, var 36mm])
  tip = line(start = [var 60mm, var 36mm], end = [var 60mm, var 43mm])
}
vaneSurface = extrude([vane.root, vane.sweep, vane.tip], length = bladeHeight, bodyType = SURFACE)
blade = thicken(vaneSurface, thickness = wallThickness, center = true)
  |> appearance(color = "#19b9b1", metalness = 85, roughness = 22)
blades = patternCircular3d(blade, instances = bladeCount, axis = Z, rotateDuplicates = true)

housingProfile = sketch(on = XY) {
  rim = circle(start = [var 78mm, var 0mm], center = [var 0mm, var 0mm])
  hub = circle(start = [var 20mm, var 0mm], center = [var 0mm, var 0mm])
}
shroudSurface = extrude(housingProfile.rim, length = 38mm, bodyType = SURFACE)
shroud = thicken(shroudSurface, thickness = 2mm, flip = true)
  |> appearance(color = "#a8dce7", metalness = 25, roughness = 15, opacity = 22)
hub = extrude(region(segments = [housingProfile.hub]), length = 36mm)
  |> appearance(color = "#172b3b", metalness = 75, roughness = 26)

lowerRimSurface = extrude(housingProfile.rim, length = 4mm, bodyType = SURFACE)
lowerRim = thicken(lowerRimSurface, thickness = 4mm, flip = false)
  |> appearance(color = "#d89d48", metalness = 85, roughness = 24)
topProfile = sketch(on = offsetPlane(XY, offset = 34mm)) {
  rim = circle(start = [var 78mm, var 0mm], center = [var 0mm, var 0mm])
  cap = circle(start = [var 16mm, var 0mm], center = [var 0mm, var 0mm])
}
upperRimSurface = extrude(topProfile.rim, length = 4mm, bodyType = SURFACE)
upperRim = thicken(upperRimSurface, thickness = 4mm, flip = false)
  |> appearance(color = "#d89d48", metalness = 85, roughness = 24)
hubCap = extrude(region(segments = [topProfile.cap]), length = 5mm)
  |> appearance(color = "#d89d48", metalness = 90, roughness = 20)
