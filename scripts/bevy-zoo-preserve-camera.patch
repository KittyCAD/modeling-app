+#[cfg(test)]
+mod tests {
+    use super::{InitialCameraFit, LoadedModelCamera};
+
+    #[test]
+    fn only_the_first_loaded_model_requests_a_camera_fit() {
+        let mut state = InitialCameraFit::default();
+
+        assert_eq!(state.finish_model_load(), LoadedModelCamera::Fit);
+        assert_eq!(state.finish_model_load(), LoadedModelCamera::Preserve);
+        assert_eq!(state.finish_model_load(), LoadedModelCamera::Preserve);
+    }
