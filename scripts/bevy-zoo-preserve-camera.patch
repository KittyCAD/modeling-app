 #[derive(Component)]
-struct PendingCameraFit;
+struct PendingModelLoad;
 
+/// Camera policy across model revisions. Loading a GLB is not a request to move
+/// the camera: only the first visible model receives the connection-start fit.
+#[derive(Resource, Clone, Copy, Debug, Default, Eq, PartialEq)]
+enum InitialCameraFit {
+    #[default]
+    Pending,
+    Complete,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum LoadedModelCamera {
+    Fit,
+    Preserve,
+}
+
+impl InitialCameraFit {
+    fn finish_model_load(&mut self) -> LoadedModelCamera {
+        match self {
+            Self::Pending => {
+                *self = Self::Complete;
+                LoadedModelCamera::Fit
+            }
+            Self::Complete => LoadedModelCamera::Preserve,
+        }
+    }
+}
