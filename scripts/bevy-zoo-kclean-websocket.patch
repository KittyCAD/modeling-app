+impl KcleanSession {
+    fn connect(endpoint: String) -> Result<Self, String> {
+        let stream = WebSocket::open(&endpoint)
+            .map_err(|error| format!("could not connect to Kclean: {error}"))?;
+        let (write, read) = stream.split();
+        KCLEAN_WARM_ENDPOINT.with(|warm| *warm.borrow_mut() = Some(endpoint.clone()));
+        Ok(Self {
+            endpoint,
+            read,
+            write,
+        })
+    }
