+fn kclean_session(endpoint: &str) -> Result<KcleanSession, String> {
+    KCLEAN_SESSION.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        if slot
+            .as_ref()
+            .is_none_or(|session| session.endpoint != endpoint)
+        {
+            clear_kclean_warm_endpoint();
+            *slot = Some(KcleanSession::connect(endpoint.to_owned())?);
+        }
+        Ok(slot
+            .as_ref()
+            .expect("Kclean session was initialized")
+            .clone())
+    })
+}
+
+fn invalidate_kclean_session(session: &KcleanSession) {
+    KCLEAN_SESSION.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        if slot
+            .as_ref()
+            .is_some_and(|active| active.generation == session.generation)
+        {
+            *slot = None;
+            clear_kclean_warm_endpoint();
+        }
+    });
+}
