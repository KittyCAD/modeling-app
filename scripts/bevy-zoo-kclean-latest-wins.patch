+/// The sole socket reader parses and routes terminal responses by request ID.
+/// This lets newer edits be sent while an older evaluation is still running.
+async fn read_kclean_session(mut read: BrowserRead, pending: PendingKcleanRequests) {
+    loop {
+        let message = match read.next().await {
+            Some(Ok(Message::Text(text))) => {
+                match serde_json::from_str::<KcleanServerMessage>(&text) {
+                    Ok(message) => message,
+                    Err(error) => {
+                        fail_pending(&pending, format!("invalid Kclean JSON response: {error}"));
+                        return;
+                    }
+                }
+            }
+            Some(Ok(Message::Bytes(_))) => {
+                fail_pending(
+                    &pending,
+                    "Kclean sent artifact bytes before result metadata".into(),
+                );
+                return;
+            }
+            Some(Err(error)) => {
+                fail_pending(&pending, format!("failed reading Kclean response: {error}"));
+                return;
+            }
+            None => {
+                fail_pending(&pending, "Kclean session closed unexpectedly".into());
+                return;
+            }
+        };
+
+        let (request_id, response) = match message {
+            KcleanServerMessage::Started { request_id } => {
+                let _ = request_id;
+                continue;
+            }
+            KcleanServerMessage::Succeeded {
+                request_id,
+                byte_length,
+            } => {
+                let solve_finished = Instant::now();
+                let glb = match read_kclean_binary(&mut read, byte_length).await {
+                    Ok(glb) => glb,
+                    Err(error) => {
+                        fail_pending(&pending, error);
+                        return;
+                    }
+                };
+                (
+                    request_id,
+                    KcleanResponse::Succeeded {
+                        glb,
+                        solve_finished,
+                        response_finished: Instant::now(),
+                    },
+                )
+            }
+            KcleanServerMessage::Halted {
+                request_id,
+                byte_length,
+                diagnostic,
+            } => {
+                let solve_finished = Instant::now();
+                let glb = if byte_length == 0 {
+                    Vec::new()
+                } else {
+                    match read_kclean_binary(&mut read, byte_length).await {
+                        Ok(glb) => glb,
+                        Err(error) => {
+                            fail_pending(&pending, error);
+                            return;
+                        }
+                    }
+                };
+                (
+                    request_id,
+                    KcleanResponse::Halted {
+                        glb,
+                        diagnostic,
+                        solve_finished,
+                        response_finished: Instant::now(),
+                    },
+                )
+            }
+            KcleanServerMessage::Failed { request_id, error } => (
+                request_id,
+                KcleanResponse::Failed {
+                    error,
+                    finished: Instant::now(),
+                },
+            ),
+            KcleanServerMessage::Superseded { request_id } => {
+                (request_id, KcleanResponse::Superseded)
+            }
+        };
+        if let Some(waiter) = pending.borrow_mut().remove(&request_id) {
+            let _ = waiter.send(Ok(response));
+        }
+    }
 }
 
+fn fail_pending(pending: &PendingKcleanRequests, message: String) {
+    for (_, waiter) in pending.borrow_mut().drain() {
+        let _ = waiter.send(Err(message.clone()));
+    }
+}
