+async fn execute_with_kclean(
+    project: KclProject,
+    host: String,
+    on_solved: impl FnOnce(Duration, Instant),
+) -> Result<ExecutionExport, String> {
+    let request = KcleanEvaluateRequest {
+        entrypoint: &project.entrypoint,
+        files: &project.files,
+        output_format: "glb",
+    };
+    let body = serde_json::to_string(&request)
+        .map_err(|error| format!("could not encode Kclean request: {error}"))?;
+    let solve_started = Instant::now();
+    let response = Request::post(&kclean_evaluation_url(&host)?)
+        .header("Content-Type", "application/json")
+        .body(body)
+        .map_err(|error| format!("could not build Kclean request: {error}"))?
+        .send()
+        .await
+        .map_err(|error| format!("could not connect to Kclean: {error}"))?;
+
+    if !response.ok() {
+        return Err(kclean_failure(response).await);
+    }
+
+    let solve_finished = Instant::now();
+    let solve_time = solve_finished.duration_since(solve_started);
+    on_solved(solve_time, solve_finished);
+
+    let response_started = Instant::now();
+    let glb = response
+        .binary()
+        .await
+        .map_err(|error| format!("could not read Kclean GLB response: {error}"))?;
+    let response_finished = Instant::now();
+    Ok(ExecutionExport {
+        glb,
+        solve_time,
+        solve_finished,
+        response_time: response_finished.duration_since(response_started),
+        response_finished,
+    })
+}
+
+fn kclean_evaluation_url(host: &str) -> Result<String, String> {
+    let host = host.trim().trim_end_matches('/');
+    if host.is_empty() {
+        return Err("Kclean server URL is empty".into());
+    }
+    if host.ends_with("/v1/evaluations") {
+        Ok(host.into())
+    } else {
+        Ok(format!("{host}/v1/evaluations"))
+    }
+}
+
+async fn kclean_failure(response: Response) -> String {
+    let status = response.status();
+    match response.text().await {
+        Ok(body) => match serde_json::from_str::<KcleanErrorEnvelope>(&body) {
+            Ok(problem) => format!(
+                "Kclean {} failed [{}]: {}",
+                problem.error.phase, problem.error.code, problem.error.message
+            ),
+            Err(_) if body.trim().is_empty() => format!("Kclean request failed with HTTP {status}"),
+            Err(_) => format!("Kclean request failed with HTTP {status}: {}", body.trim()),
+        },
+        Err(error) => format!("Kclean request failed with HTTP {status}: {error}"),
+    }
+}
