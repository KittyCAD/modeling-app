@settings(kclVersion = 3.0, defaultLengthUnit = mm)

sketch001 = sketch(on = XY) {
  line1 = line(start = [var -22.19mm, var 13.83mm], end = [var 22.21mm, var 13.83mm])
  line2 = line(start = [var 22.21mm, var 13.83mm], end = [var 22.21mm, var -8.56mm])
  line3 = line(start = [var 22.21mm, var -8.56mm], end = [var -22.19mm, var -8.56mm])
  line4 = line(start = [var -22.19mm, var -8.56mm], end = [var -22.19mm, var 13.83mm])
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
  parallel([line2, line4])
  parallel([line3, line1])
  perpendicular([line1, line2])
  horizontal(line3)
}
hidden001 = hide(sketch001)
region001 = region(segments = [sketch001.line1, sketch001.line2], direction = CW)
extrude001 = extrude(region001, length = 50)
face001 = faceOf(extrude001, face = region001.tags.line3)
sketch002 = sketch(on = face001) {
  line1 = line(start = [var 0mm, var 42.41mm], end = [var 10.18mm, var 42.41mm])
  line2 = line(start = [var 10.18mm, var 42.41mm], end = [var 10.18mm, var 33.11mm])
  line3 = line(start = [var 10.18mm, var 33.11mm], end = [var 0mm, var 33.11mm])
  line4 = line(start = [var 0mm, var 33.11mm], end = [var 0mm, var 42.41mm])
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
  parallel([line2, line4])
  parallel([line3, line1])
  perpendicular([line1, line2])
  horizontal(line3)
  vertical([line1.start, ORIGIN])
}
hidden002 = hide(sketch002)
region002 = region(segments = [sketch002.line1, sketch002.line2], direction = CW)
extrude002 = extrude(region002, length = 20, method = NEW)
chamfer001 = chamfer(
  extrude002,
  edges = [{ sideFaces = [region002.tags.line1, region002.tags.line2] }],
  length = 5,
  tag = $chamferFace01,
)
sketch003 = sketch(on = faceOf(chamfer001, face = chamferFace01)) {
  line1 = line(start = [var -38.13mm, var -28.48mm], end = [var -32.83mm, var -28.48mm])
  line2 = line(start = [var -32.83mm, var -28.48mm], end = [var -32.83mm, var -31.36mm])
  line3 = line(start = [var -32.83mm, var -31.36mm], end = [var -38.13mm, var -31.36mm])
  line4 = line(start = [var -38.13mm, var -31.36mm], end = [var -38.13mm, var -28.48mm])
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
  parallel([line2, line4])
  parallel([line3, line1])
  perpendicular([line1, line2])
  horizontal(line3)
}
hidden003 = hide(sketch003)
region003 = region(segments = [sketch003.line1, sketch003.line2], direction = CW)
extrude003 = extrude(region003, length = 30, method = NEW)
sketch004 = sketch(on = -XZ) {
  line1 = line(start = [var -36.42mm, var 77.49mm], end = [var -34.64mm, var 77.49mm])
  line2 = line(start = [var -34.64mm, var 77.49mm], end = [var -34.64mm, var 50.61mm])
  line3 = line(start = [var -34.64mm, var 50.61mm], end = [var -36.42mm, var 50.61mm])
  line4 = line(start = [var -36.42mm, var 50.61mm], end = [var -36.42mm, var 77.49mm])
  coincident([line1.end, line2.start])
  coincident([line2.end, line3.start])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
  parallel([line2, line4])
  parallel([line3, line1])
  perpendicular([line1, line2])
  horizontal(line3)
}
hidden004 = hide(sketch004)
region004 = region(segments = [sketch004.line1, sketch004.line2], direction = CW)
extrude004 = extrude(region004, length = -100)
export finished = subtract(extrude001, tools = extrude004)
