@settings(kclVersion = 3.0, defaultLengthUnit = mm)

profile = sketch(on = XY) {
  front = line(start = [0mm, 0mm], end = [30mm, 0mm])
  right = line(start = [30mm, 0mm], end = [30mm, 24mm])
  back = line(start = [30mm, 24mm], end = [0mm, 24mm])
  left = line(start = [0mm, 24mm], end = [0mm, 0mm])
}
baseRegion = region(segments = [profile.front, profile.right])
base = extrude(baseRegion, length = 16mm)
export tray = shell(base, thickness = 2mm, faces = [END])
